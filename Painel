        local function CreateDrawingsForPlayer(player) 
            if not player or player == LocalPlayer or PlayerDrawings[player] then return end
            local nameText = Drawing.new("Text") nameText.Visible = false nameText.Center = true nameText.Outline = true nameText.Font = 2
            PlayerDrawings[player] = { Name = nameText, Line = Drawing.new("Line"), Box = Drawing.new("Square"), Health = Drawing.new("Line"), SkelLines = {}, SkelCircle = Drawing.new("Circle") }
