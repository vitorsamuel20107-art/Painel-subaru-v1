        end
        if type(RapidEquipInventoryController) ~= "table" then return nil end
        local getter = rawget(RapidEquipInventoryController, "peekCurrentEquippedForMovement")
        if type(getter) ~= "function" then return nil end
        local ok, weapon = pcall(getter)
        if ok and type(weapon) == "table"
            and rawget(weapon, "WeaponEquippedTick") ~= nil
            and rawget(weapon, "IsEquipped") == true then
            return weapon
        end
        return nil
    end

    local function RapidEquip_RefreshWeaponComp()
        local raw = LocalPlayer:GetAttribute("CurrentEquipped")
        if not raw then
            RapidEquipWeaponComp = nil
            RapidEquipLastIdentifier = ""
            return
        end
        local identifier = tostring(raw):match('"Identifier":"([^"]+)"') or tostring(raw)
        if identifier == RapidEquipLastIdentifier and RapidEquipWeaponComp
            and rawget(RapidEquipWeaponComp, "IsEquipped") == true then
            return
        end
        RapidEquipLastIdentifier = identifier
        task.defer(function()
            local comp = RapidEquip_FindCompForEquipped()
            if LocalPlayer:GetAttribute("CurrentEquipped") == raw then
                RapidEquipWeaponComp = comp
            end
        end)
    end

