        local function AntiLag_Remember(records, object, property)
            if not object then return nil end
            local record = records[object]
            if not record then
                record = { Values = {}, Seen = {} }
                records[object] = record
            end
            if not record.Seen[property] then
                local ok, value = pcall(function() return object[property] end)
                if ok then
                    record.Values[property] = value
                    record.Seen[property] = true
                end
            end
            return record
        end

        local function AntiLag_RestoreRecords(records)
            for object, record in pairs(records) do
                if object then
                    for property, value in pairs(record.Values) do
                        pcall(function() object[property] = value end)
                    end
                    if record.RestoreParent then
                        pcall(function() object.Parent = record.Parent end)
                    end
                end
                records[object] = nil
            end
        end

        local function AntiLag_DisableVisualEffect(object, records)
            if object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam")
                or object:IsA("Smoke") or object:IsA("Fire") or object:IsA("Sparkles") then
                AntiLag_Remember(records, object, "Enabled")
                pcall(function() object.Enabled = false end)
                if object:IsA("ParticleEmitter") then
                    AntiLag_Remember(records, object, "Rate")
                    AntiLag_Remember(records, object, "Transparency")
                    pcall(function()
                        object.Rate = 0
                        object.Transparency = NumberSequence.new(1)
                    end)
                end
            elseif object:IsA("Explosion") then
                AntiLag_Remember(records, object, "Visible")
                pcall(function() object.Visible = false end)
            end
        end

