    local function _startFlashGuiFallback()
        if _flashGuiConn then return end
        _flashGuiConn = NIGHT_TrackConnection(LocalPlayer.PlayerGui.ChildAdded:Connect(function(c)
            if NoFlash_Enabled and (c.Name == "FlashbangEffect" or c.Name == "FlashScreenshot") then
                pcall(function() c:Destroy() end)
            end
        end))
        _flashLightConn = NIGHT_TrackConnection(Lighting.ChildAdded:Connect(function(c)
            if NoFlash_Enabled and c.Name == "FlashbangColorCorrection" then
                pcall(function() c.Brightness = 0 c.Saturation = 0 c.TintColor = Color3.new(1,1,1) end)
