    local BulletTrailDebris = game:GetService("Debris")
    local BulletTrailCFG = {
        Enabled = BulletTrailEnabled,
        Color0 = Color3.fromRGB(0, 180, 255),
        Color1 = Color3.fromRGB(100, 220, 255),
        Width0 = 0.08,
        Width1 = 0.02,
