    }
    -- Bounds do personagem projetados pela câmera.
    -- Usa apenas as partes do corpo — ignora armas, tools e acessórios.
    local function GetScreenBounds(model)
        local cam = workspace.CurrentCamera or Camera
        if not model or not model.Parent or not cam then return nil end

        local minX, minY = math.huge, math.huge
        local maxX, maxY = -math.huge, -math.huge
        local valid = 0

        for _, partName in ipairs(BODY_PARTS) do
            local part = model:FindFirstChild(partName)
            if part and part:IsA("BasePart") then
                -- Projeta os 8 cantos da part para cobrir rotações
                local hx = part.Size.X * 0.5
                local hy = part.Size.Y * 0.5
                local hz = part.Size.Z * 0.5
                local cf = part.CFrame
                for _, ox in ipairs({-hx, hx}) do
                    for _, oy in ipairs({-hy, hy}) do
                        for _, oz in ipairs({-hz, hz}) do
                            local wp = cf:PointToWorldSpace(Vector3.new(ox, oy, oz))
                            local sp = cam:WorldToViewportPoint(wp)
                            if sp.Z > 0 then
                                valid = valid + 1
                                if sp.X < minX then minX = sp.X end
                                if sp.Y < minY then minY = sp.Y end
                                if sp.X > maxX then maxX = sp.X end
                                if sp.Y > maxY then maxY = sp.Y end
                            end
                        end
                    end
                end
            end
        end

        if valid == 0 or minX == math.huge then return nil end
        local viewport = cam.ViewportSize
        if maxX < 0 or maxY < 0 or minX > viewport.X or minY > viewport.Y then return nil end
        local width  = maxX - minX
        local height = maxY - minY
        if width < 2 or height < 2 then return nil end
        return {
            Left=minX, Top=minY, Right=maxX, Bottom=maxY,
            Width=width, Height=height,
            CenterX=(minX+maxX)*0.5, CenterY=(minY+maxY)*0.5,
            Viewport=viewport
        }
    end

