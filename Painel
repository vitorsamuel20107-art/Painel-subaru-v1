        local function AntiLag_ProcessBasic(object)
            if not AntiLagState.Basic or not object or not object.Parent then return end
            AntiLag_DisableVisualEffect(object, AntiLagState.BasicRecords)
        end

        local function AntiLag_ProcessV2(object, isMapGeometry)
            if not AntiLagState.V2 or not object or not object.Parent then return end
            if object:IsA("BasePart") then
                AntiLag_Remember(AntiLagState.V2Records, object, "Material")
                AntiLag_Remember(AntiLagState.V2Records, object, "Reflectance")
                AntiLag_Remember(AntiLagState.V2Records, object, "CastShadow")
                AntiLag_Remember(AntiLagState.V2Records, object, "MaterialVariant")
                pcall(function()
                    object.Material = Enum.Material.SmoothPlastic
                    object.Reflectance = 0
                    object.CastShadow = false
                    object.MaterialVariant = ""
                end)
                if object:IsA("MeshPart") then
                    AntiLag_Remember(AntiLagState.V2Records, object, "TextureID")
                    pcall(function() object.TextureID = "" end)
                end
                if isMapGeometry then AntiLag_AssignMapChunk(object) end
            elseif object:IsA("Texture") or object:IsA("Decal") then
                AntiLag_Remember(AntiLagState.V2Records, object, "Transparency")
                pcall(function() object.Transparency = 1 end)
            elseif object:IsA("SurfaceAppearance") then
                local record = AntiLag_Remember(AntiLagState.V2Records, object, "Parent")
                if record and not record.RestoreParent then
                    record.Parent = object.Parent
                    record.RestoreParent = true
                    pcall(function() object.Parent = nil end)
                end
            elseif object:IsA("SpecialMesh") then
                AntiLag_Remember(AntiLagState.V2Records, object, "TextureId")
                pcall(function() object.TextureId = "" end)
            elseif object:IsA("Shirt") then
                AntiLag_Remember(AntiLagState.V2Records, object, "ShirtTemplate")
                pcall(function() object.ShirtTemplate = "" end)
            elseif object:IsA("Pants") then
                AntiLag_Remember(AntiLagState.V2Records, object, "PantsTemplate")
                pcall(function() object.PantsTemplate = "" end)
            elseif object:IsA("ShirtGraphic") then
                AntiLag_Remember(AntiLagState.V2Records, object, "Graphic")
                pcall(function() object.Graphic = "" end)
            elseif object:IsA("Light") then
                AntiLag_Remember(AntiLagState.V2Records, object, "Shadows")
                AntiLag_Remember(AntiLagState.V2Records, object, "Enabled")
                pcall(function()
                    object.Shadows = false
                    object.Enabled = false
                end)
            end
            AntiLag_DisableVisualEffect(object, AntiLagState.V2Records)
        end

        local function AntiLag_ScanRoot(root, processor, generation, isMapGeometry, rootName)
            if not root then return end
            task.spawn(function()
                local stack = { root }
                local processed = 0
                while #stack > 0 do
                    if generation ~= AntiLagState.ScanGenerations[rootName] then return end
                    if processor == "Basic" and not AntiLagState.Basic then return end
                    if processor == "V2" and not AntiLagState.V2 then return end
                    local object = stack[#stack]
                    stack[#stack] = nil
                    if object ~= root then
                        if processor == "Basic" then AntiLag_ProcessBasic(object)
                        else AntiLag_ProcessV2(object, isMapGeometry == true) end
                    end
                    local children = object:GetChildren()
                    for i = 1, #children do stack[#stack + 1] = children[i] end
                    processed = processed + 1
                    if processed % 160 == 0 then task.wait() end
                end
            end)
        end

        local function AntiLag_AttachRoot(rootName, root, processor, isMapGeometry)
            if not root then return end
            local old = AntiLagState.RootRefs[rootName]
            if old == root then return end
            local oldConnections = AntiLagState.RootConnections[rootName]
            if oldConnections then
                for _, connection in ipairs(oldConnections) do pcall(function() connection:Disconnect() end) end
            end
            AntiLagState.RootRefs[rootName] = root
            local connections = {}
            connections[#connections + 1] = NIGHT_TrackConnection(root.DescendantAdded:Connect(function(object)
                if processor == "Basic" then
                    if AntiLagState.Basic then task.defer(AntiLag_ProcessBasic, object) end
                elseif AntiLagState.V2 then
                    task.defer(AntiLag_ProcessV2, object, isMapGeometry == true)
                end
            end))
            connections[#connections + 1] = NIGHT_TrackConnection(root.DescendantRemoving:Connect(function(object)
                if isMapGeometry and object:IsA("BasePart") then
                    AntiLag_RemovePartFromCell(object)
                end
            end))
            AntiLagState.RootConnections[rootName] = connections
            AntiLagState.ScanGeneration = AntiLagState.ScanGeneration + 1
            AntiLagState.ScanGenerations[rootName] = (AntiLagState.ScanGenerations[rootName] or 0) + 1
            AntiLag_ScanRoot(root, processor, AntiLagState.ScanGenerations[rootName], isMapGeometry, rootName)
        end

        local function AntiLag_DisconnectRoot(rootName)
            local connections = AntiLagState.RootConnections[rootName]
            if connections then
                for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end
            end
            AntiLagState.RootConnections[rootName] = nil
            AntiLagState.RootRefs[rootName] = nil
            AntiLagState.ScanGenerations[rootName] = (AntiLagState.ScanGenerations[rootName] or 0) + 1
        end

        local function AntiLag_ApplyGlobalSettings()
            local enabled = AntiLagState.Basic or AntiLagState.V2
            if enabled then
                if not AntiLagState.GlobalOriginal then
                    AntiLagState.GlobalOriginal = {}
                    pcall(function() AntiLagState.GlobalOriginal.Quality = settings().Rendering.QualityLevel end)
                    pcall(function() AntiLagState.GlobalOriginal.GlobalShadows = Lighting.GlobalShadows end)
                end
                pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
                pcall(function() Lighting.GlobalShadows = false end)
            else
                local original = AntiLagState.GlobalOriginal
                if original then
                    if original.Quality ~= nil then pcall(function() settings().Rendering.QualityLevel = original.Quality end) end
                    if original.GlobalShadows ~= nil then pcall(function() Lighting.GlobalShadows = original.GlobalShadows end) end
                end
                AntiLagState.GlobalOriginal = nil
            end

            local terrain = Workspace:FindFirstChildOfClass("Terrain")
            if AntiLagState.V2 and terrain then
                if not AntiLagState.TerrainDecorationCaptured then
                    pcall(function()
                        AntiLagState.TerrainDecorationOriginal = terrain.Decoration
                        AntiLagState.TerrainDecorationCaptured = true
                    end)
                end
                pcall(function() terrain.Decoration = false end)
            elseif not AntiLagState.V2 and AntiLagState.TerrainDecorationCaptured and terrain then
                pcall(function() terrain.Decoration = AntiLagState.TerrainDecorationOriginal end)
                AntiLagState.TerrainDecorationCaptured = false
                AntiLagState.TerrainDecorationOriginal = nil
            end
        end

        local function AntiLag_ProcessLightingEffect(object)
            if not AntiLagState.V2 then return end
            if object:IsA("BloomEffect") or object:IsA("SunRaysEffect")
                or object:IsA("DepthOfFieldEffect") or object:IsA("BlurEffect") then
                AntiLag_Remember(AntiLagState.V2Records, object, "Enabled")
                pcall(function() object.Enabled = false end)
            elseif object:IsA("Clouds") then
                AntiLag_Remember(AntiLagState.V2Records, object, "Enabled")
                pcall(function() object.Enabled = false end)
            end
        end

        local function AntiLag_SetLightingHooks()
            if AntiLagState.V2 then
                if not AntiLagState.Connections.LightingAdded then
                    AntiLagState.Connections.LightingAdded = NIGHT_TrackConnection(Lighting.ChildAdded:Connect(AntiLag_ProcessLightingEffect))
                end
                local terrain = Workspace:FindFirstChildOfClass("Terrain")
                if terrain and not AntiLagState.Connections.TerrainAdded then
                    AntiLagState.Connections.TerrainAdded = NIGHT_TrackConnection(terrain.ChildAdded:Connect(AntiLag_ProcessLightingEffect))
                end
                for _, object in ipairs(Lighting:GetChildren()) do AntiLag_ProcessLightingEffect(object) end
                if terrain then for _, object in ipairs(terrain:GetChildren()) do AntiLag_ProcessLightingEffect(object) end end
            else
                for _, key in ipairs({ "LightingAdded", "TerrainAdded" }) do
                    local connection = AntiLagState.Connections[key]
                    if connection then connection:Disconnect(); AntiLagState.Connections[key] = nil end
                end
            end
        end

        local function AntiLag_UpdateChunks()
            if not AntiLagState.V2 then return end
            local camera = Workspace.CurrentCamera
            if not camera then return end
            local position = camera.CFrame.Position
            local radius = 128 * 2.35
            local radiusSquared = radius * radius
            for key, cell in pairs(AntiLagState.Cells) do
                local centerX = (cell.X + 0.5) * 128
                local centerY = (cell.Y + 0.5) * 128
                local centerZ = (cell.Z + 0.5) * 128
                local dx, dy, dz = centerX - position.X, centerY - position.Y, centerZ - position.Z
                local visible = (dx*dx + dy*dy + dz*dz) <= radiusSquared
                if cell.Visible ~= visible then
                    cell.Visible = visible
                    for part in pairs(cell.Parts) do
                        if part and part.Parent then
                            local record = AntiLagState.V2Records[part]
                            local original = 0
                            if record and record.Seen.LocalTransparencyModifier then
                                original = record.Values.LocalTransparencyModifier or 0
                            end
                            pcall(function()
                                part.LocalTransparencyModifier = visible and original or 1
                            end)
                        else
                            cell.Parts[part] = nil
                        end
                    end
                end
                if next(cell.Parts) == nil then AntiLagState.Cells[key] = nil end
            end
        end

        local function AntiLag_StartChunkLoop()
            AntiLagState.ChunkGeneration = AntiLagState.ChunkGeneration + 1
            local generation = AntiLagState.ChunkGeneration
            task.spawn(function()
                while NIGHT_IsCurrent() and AntiLagState.V2 and generation == AntiLagState.ChunkGeneration do
                    AntiLag_UpdateChunks()
                    task.wait(0.45)
                end
            end)
        end

