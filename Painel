-- Runtime singleton: reexecutar o arquivo substitui a instância anterior.
local NIGHT_Environment = (type(getgenv) == "function" and getgenv()) or _G
local NIGHT_RUNTIME_KEY = "__NIGHT_FFH4X_RUNTIME_SINGLETON"
local NIGHT_PreviousRuntime = rawget(NIGHT_Environment, NIGHT_RUNTIME_KEY)

if type(NIGHT_PreviousRuntime) == "table" then
    NIGHT_PreviousRuntime.Active = false
    for _, connection in ipairs(NIGHT_PreviousRuntime.Connections or {}) do
        pcall(function() connection:Disconnect() end)
    end
    for _, instance in ipairs(NIGHT_PreviousRuntime.Instances or {}) do
        pcall(function()
            if instance and instance.Parent then instance:Destroy() end
        end)
    end
end

local NIGHT_Runtime = { Active = true, Connections = {}, Instances = {} }
rawset(NIGHT_Environment, NIGHT_RUNTIME_KEY, NIGHT_Runtime)

local function NIGHT_IsCurrent()
    return NIGHT_Runtime.Active
        and rawget(NIGHT_Environment, NIGHT_RUNTIME_KEY) == NIGHT_Runtime
end

local function NIGHT_TrackConnection(connection)
    if connection and connection.Connected then
        table.insert(NIGHT_Runtime.Connections, connection)
    end
    return connection
end

local function NIGHT_TrackInstance(instance)
    if instance then table.insert(NIGHT_Runtime.Instances, instance) end
    return instance
end

local NIGHT_Connections = NIGHT_Runtime.Connections

local function toHex(color) return string.format("#%02X%02X%02X", color.R*255, color.G*255, color.B*255) end
local function fromHex(hex)
    if type(hex) ~= "string" then return Color3.fromRGB(255, 0, 0) end
    if hex == "RAINBOW" then return Color3.fromRGB(255, 0, 0) end
    local r, g, b = hex:match("#(%x%x)(%x%x)(%x%x)")
    if r and g and b then return Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)) end
    return Color3.fromRGB(255, 0, 0)
end

local function SaveAllSettings() 
    if writefile then writefile(MainConfigFile, HttpService:JSONEncode(GlobalSettings)) end
end

local function LoadAllSettings()
    if isfile and readfile and isfile(MainConfigFile) then
        local data = readfile(MainConfigFile)
        if data and data ~= "" then
            local decodeOk, decoded = pcall(function()
                return HttpService:JSONDecode(data)
            end)
            if decodeOk and type(decoded) == "table" then
                for k, v in pairs(type(decoded.Toggles) == "table" and decoded.Toggles or {}) do
                    GlobalSettings.Toggles[k] = (v == true)
                end
                for k, v in pairs(type(decoded.Sliders) == "table" and decoded.Sliders or {}) do
                    GlobalSettings.Sliders[k] = tonumber(v)
                end
                for k, v in pairs(type(decoded.Dropdowns) == "table" and decoded.Dropdowns or {}) do
                    GlobalSettings.Dropdowns[k] = tostring(v)
                end
                if decoded.ThemeHex then GlobalSettings.ThemeHex = tostring(decoded.ThemeHex) end
                if decoded.TriggerLocked ~= nil then GlobalSettings.TriggerLocked = (decoded.TriggerLocked == true) end
                if type(decoded.ESP_Colors) == "table" then
                    for k, v in pairs(decoded.ESP_Colors) do
                        GlobalSettings.ESP_Colors[k] = tostring(v)
                    end
                end
            else
                warn("[NIGHT] Configuração inválida; usando padrões sem interromper o script.")
            end
        end
    end
end
LoadAllSettings()

