    local WallbangHooked = false
    _G.WallBangAtivado = GlobalSettings.Toggles["Bala Mágica"] == true
    local function WallBang_Hook()
        if WallbangHooked then return end
        WallbangHooked = true
        local LOG_PRIVADO = -3.0999999046325684 
        local mt = getrawmetatable(game) 
        local oldNamecall = mt.__namecall 
        setreadonly(mt, false)
        local rayParams = RaycastParams.new() 
        rayParams.FilterType = Enum.RaycastFilterType.Exclude 
        rayParams.FilterDescendantsInstances = {LocalPlayer.Character, workspace:FindFirstChild("Map") or workspace:FindFirstChild("Geometry")}
        rayParams.IgnoreWater = true
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod() 
            local args = {...}
            if _G.WallBangAtivado and method == "Raycast" and not checkcaller() then
                local dirOriginal = args[2]
                if typeof(dirOriginal) == "Vector3" and math.abs(dirOriginal.Y - LOG_PRIVADO) < 0.0001 then return oldNamecall(self, unpack(args)) end
                args[1] = Camera.CFrame.Position 
                args[2] = Camera.CFrame.LookVector * 1e6 
                args[3] = rayParams 
                return oldNamecall(self, unpack(args))
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true) 
    end
    if _G.WallBangAtivado then WallBang_Hook() end

