            AntiLag_StartChunkLoop()
        end

        local function AntiLag_StopV2()
            AntiLagState.V2 = false
            AntiLagState.ChunkGeneration = AntiLagState.ChunkGeneration + 1
            for _, rootName in ipairs({ "V2Map", "V2Characters", "V2WeaponStash", "V2Debris", "V2Camera" }) do
