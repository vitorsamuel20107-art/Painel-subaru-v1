            if not player or player == LocalPlayer or PlayerLifecycleConnections[player] then return end
            local connections = {}
            local function invalidate()
                ClearPlayerShellCache(player)
                local drawings = PlayerDrawings[player]
                if drawings then
                    drawings.Name.Visible = false
                    drawings.Line.Visible = false
                    drawings.Box.Visible = false
                    drawings.Health.Visible = false
                    for _, line in ipairs(drawings.SkelLines) do line.Visible = false end
                    drawings.SkelCircle.Visible = false
                end
            end
            connections[#connections + 1] = player.CharacterAdded:Connect(invalidate)
            connections[#connections + 1] = player.CharacterRemoving:Connect(invalidate)
            PlayerLifecycleConnections[player] = connections
        end

