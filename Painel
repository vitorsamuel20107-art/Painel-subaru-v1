    -- Seleção fixa ou ponderada por região, com chance geral e limites próprios.
    local SA_BurstIndex = 0
    local SA_RaycastParams = RaycastParams.new()
    SA_RaycastParams.FilterType = Enum.RaycastFilterType.Exclude
    SA_RaycastParams.IgnoreWater = true

    local SA_PART_OPTIONS = {
        { Key = "Head", Names = {"Head"} },
        { Key = "UpperTorso", Names = {"UpperTorso", "Torso"} },
        { Key = "LowerTorso", Names = {"LowerTorso", "Torso", "HumanoidRootPart"} },
        { Key = "LeftArm", Names = {"LeftUpperArm", "Left Arm", "LeftLowerArm"} },
        { Key = "RightArm", Names = {"RightUpperArm", "Right Arm", "RightLowerArm"} },
        { Key = "LeftLeg", Names = {"LeftUpperLeg", "Left Leg", "LeftLowerLeg"} },
        { Key = "RightLeg", Names = {"RightUpperLeg", "Right Leg", "RightLowerLeg"} },
    }

    local function aimSilent_findPart(shell, key)
        if not shell then return nil end
        for _, option in ipairs(SA_PART_OPTIONS) do
            if option.Key == key then
                for _, name in ipairs(option.Names) do
                    local part = shell:FindFirstChild(name)
                    if part and part:IsA("BasePart") then return part end
                end
                break
            end
        end
        return nil
    end

    local function aimSilent_pickPart(shell)
        local pull = Aimbot_Settings.PullPart or "Head"
        return aimSilent_findPart(shell, pull) or shell:FindFirstChild("Head") or shell:FindFirstChild("HumanoidRootPart")
    end

    local function aimSilent_getPart(shell)
        return aimSilent_pickPart(shell)
    end

    local function aimSilent_tryRedirect(shell)
        if not shell then return nil end
        if Aimbot_Settings.SA_PartMode ~= "Aleatório" then
            return aimSilent_pickPart(shell)
        end

        local weights = Aimbot_Settings.SA_Weights
        local total = 0
        for _, option in ipairs(SA_PART_OPTIONS) do
            total = total + math.max(0, tonumber(weights[option.Key]) or 0)
        end
        if total <= 0 then return aimSilent_pickPart(shell) end

        local roll = math.random() * total
        local accumulated = 0
        for _, option in ipairs(SA_PART_OPTIONS) do
            accumulated = accumulated + math.max(0, tonumber(weights[option.Key]) or 0)
            if roll <= accumulated then
                return aimSilent_findPart(shell, option.Key) or aimSilent_pickPart(shell)
            end
        end
        return aimSilent_pickPart(shell)
    end

    local function aimSilent_getClosestTarget()
        local fovRadius = math.max(1, tonumber(Aimbot_Settings.SA_Fov) or 160) / 2
        local maxDistance = math.max(1, tonumber(Aimbot_Settings.SA_MaxDistance) or 500)
        local best, bestScore = nil, math.huge
        local center = Camera.ViewportSize / 2
        local priorityMode = Aimbot_Settings.SA_Priority or "Centro"
        local targetMode = Aimbot_Settings.SA_Targets or "Ambos"
        local includePlayers = targetMode == "Jogadores" or targetMode == "Ambos"
        local includeBots = targetMode == "Bots" or targetMode == "Ambos"
        local myTeam = LocalPlayer:GetAttribute("Team")

        local function considerShell(shell, targetTeam)
            if not shell or not isShellAlive(shell) then return end
            if Aimbot_Settings.SA_TeamCheck and myTeam and targetTeam and myTeam == targetTeam then return end
            local part = aimSilent_getPart(shell)
            if not part or not part:IsA("BasePart") then return end
            local worldDistance = (part.Position - Camera.CFrame.Position).Magnitude
            if worldDistance > maxDistance then return end

            if Aimbot_Settings.SA_WallCheck then
                local origin = Camera.CFrame.Position
                SA_RaycastParams.FilterDescendantsInstances = {LocalPlayer.Character, shell}
                if workspace:Raycast(origin, part.Position - origin, SA_RaycastParams) then return end
            end

            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen or screenPos.Z <= 0 then return end
            local screenDistance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
            if screenDistance > fovRadius then return end
            local score = priorityMode == "Distância" and worldDistance or screenDistance
            if score < bestScore then
                bestScore = score
                best = part
            end
        end

        if includePlayers then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local shell = getVisibleShell(player)
                    if shell and isValidPlayerShell(player, shell) then
                        considerShell(shell, player:GetAttribute("Team"))
                    end
                end
            end
        end

        if includeBots then
            for _, botShell in ipairs(getAllBotShells()) do
                if isValidBotShell(botShell) then
                    considerShell(botShell, botShell:GetAttribute("Team"))
                end
            end
        end
        return best
    end

    local function aimSilent_hook()
        if AimSilent_Hooked then return end
        AimSilent_Hooked = true
        local bulletMod = nil
        local components = ReplicatedStorage:FindFirstChild("Components")
        local weaponFolder = components and components:FindFirstChild("Weapon")
        local classes = weaponFolder and weaponFolder:FindFirstChild("Classes")
        local bulletModule = classes and classes:FindFirstChild("Bullet")
        if bulletModule and bulletModule:IsA("ModuleScript") then
            local ok, result = pcall(require, bulletModule)
            if ok and type(result) == "table" and type(result._performRaycast) == "function" then
                bulletMod = result
            end
        end
        if bulletMod then
            local origPerform = bulletMod._performRaycast
            bulletMod._performRaycast = newcclosure(function(self, spread)
                local result = origPerform(self, spread)
                if AimSilent_Enabled then
                    -- Encontra o alvo mais próximo no FOV
                    local closestPart = aimSilent_getClosestTarget()
                    if not closestPart then return result end

                    local shell = closestPart:FindFirstAncestorOfClass("Model") or closestPart.Parent

                    -- Chance geral de assistência por disparo.
                    local hitChance = math.clamp(tonumber(Aimbot_Settings.SA_HitChance) or 100, 0, 100)
                    if hitChance < 100 and math.random(1, 100) > hitChance then return result end

                    local targetPart = aimSilent_tryRedirect(shell)
                    if not targetPart then return result end

                    local origin   = Camera.CFrame.Position
                    local targetPos = targetPart.Position

                    -- Predição de movimento (slider 0-100 → fator 0-0.15)
                    local predictK = (tonumber(Aimbot_Settings.SA_Predict) or 0) * 0.0015
                    if predictK > 0 then
                        local root = shell:FindFirstChild("HumanoidRootPart")
                        if root then
                            local vel = root.AssemblyLinearVelocity
                            if vel and vel.Magnitude > 0.5 then
                                local dist = (targetPos - origin).Magnitude
                                targetPos = targetPos + vel * (dist / 500) * predictK
                            end
                        end
                    end

                    -- Limita a sequência de disparos assistidos antes de um disparo normal.
                    SA_BurstIndex = SA_BurstIndex + 1
                    local burstSize = math.max(1, math.floor(Aimbot_Settings.SA_BurstCount or 1))
                    if SA_BurstIndex > burstSize then
                        SA_BurstIndex = 0
                        return result  -- esgotou o burst, tiro normal
                    end

                    local targetDirection = (targetPos - origin).Unit
                    local strength = math.clamp(tonumber(Aimbot_Settings.SA_Strength) or 100, 0, 100) / 100
                    local originalDirection = result.Direction
                    if typeof(originalDirection) == "Vector3" and originalDirection.Magnitude > 0.001 and strength < 1 then
                        local blended = originalDirection.Unit:Lerp(targetDirection, strength)
                        result.Direction = blended.Magnitude > 0.001 and blended.Unit or targetDirection
                    else
                        result.Direction = targetDirection
                    end
                    local dir = result.Direction

                    local rayParams = RaycastParams.new()
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                    if LocalPlayer.Character then rayParams.FilterDescendantsInstances = {LocalPlayer.Character} end
                    local range = (self.Properties and self.Properties.Range) or 500
                    local hit = workspace:Raycast(origin, dir * range, rayParams)
                    if hit then
                        result.Distance = (hit.Position - origin).Magnitude
                        result.Hits = {{ Position = hit.Position, Instance = hit.Instance, Material = hit.Material and hit.Material.Name or "Plastic", Normal = hit.Normal or Vector3.new(0,1,0), Exit = false }}
                    end
                end
                return result
            end)
        else
            -- Módulo de Bullet não disponível nesta versão do jogo; não varrer memória como fallback.
        end
    end
    if AimSilent_Enabled then task.spawn(function() task.wait(0.1) aimSilent_hook() end) end

