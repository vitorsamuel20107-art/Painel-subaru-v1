    local VISIBLE_ATTR = "ClientCharacterPresentationVisible"
    local OWNER_ATTR = "PresentationOwnerUserId"
    local OWNED_ATTR = "ClientOwnedCharacterPresentation"
    local CHARACTER_TYPE_ATTR = "CharacterType"
    local GENERATION_ATTR = "CharacterGeneration"

    -- O dump do jogo confirma que personagens apresentados pelo cliente usam
    -- estes atributos. Dummies/cutouts do mapa não passam nesse filtro.
    local VisibleShellCache = {}
    local VisibleShellCacheAt = {}
    local NO_VISIBLE_SHELL = {}
    local VISIBLE_CACHE_TTL = 0.04
    local BOT_CACHE_TTL = 0.15
    local BotShellCache = {}
    local BotShellCacheAt = 0

    local function isValidPlayerShell(player, model)
        if not player or not model or not model:IsA("Model") then return false end
        if not model:IsDescendantOf(workspace) then return false end
        if model:GetAttribute(CHARACTER_TYPE_ATTR) ~= "PlayerCustomCharacter" then return false end
        if model:GetAttribute(OWNED_ATTR) ~= true then return false end
        if model:GetAttribute(OWNER_ATTR) ~= player.UserId then return false end
        if model:GetAttribute(VISIBLE_ATTR) ~= true then return false end
        if model:GetAttribute("Bot") == true then return false end
        if model:GetAttribute("TutorialDummy") == true or model:GetAttribute("TutorialCutout") == true then return false end
        if model:GetAttribute("Dead") ~= false then return false end
        local hp = model:GetAttribute("Health")
        local maxHp = model:GetAttribute("MaxHealth")
        if type(hp) ~= "number" or hp <= 0 then return false end
        if type(maxHp) ~= "number" or maxHp <= 0 or hp > maxHp then return false end
        local root = model:FindFirstChild("HumanoidRootPart")
        return root ~= nil and root:IsA("BasePart")
    end

    -- BotCharacters.lua valida cada Combatant pelo ID, ActorId e Generation.
    -- Reproduzimos apenas essa validação pontual; não fazemos varredura do mapa.
    local function isValidBotShell(model)
        if not model or not model:IsA("Model") or not model:IsDescendantOf(workspace) then return false end
        if model:GetAttribute("Bot") ~= true then return false end
        if model:GetAttribute(CHARACTER_TYPE_ATTR) ~= "PlayerCustomCharacter" then return false end
        if model:GetAttribute(OWNED_ATTR) ~= true or model:GetAttribute(VISIBLE_ATTR) ~= true then return false end
        if model:GetAttribute("TutorialDummy") == true or model:GetAttribute("TutorialCutout") == true then return false end
        if model:GetAttribute("Dead") ~= false then return false end
        local hp = model:GetAttribute("Health")
        if type(hp) ~= "number" or hp <= 0 then return false end

        local combatantId = model:GetAttribute("CombatantId")
        local actorId = model:GetAttribute("ActorId")
        local generation = model:GetAttribute(GENERATION_ATTR)
        local characterName = model:GetAttribute("CharacterName")
        if type(combatantId) ~= "number" or combatantId < 1 or combatantId > 9007199254740991 or combatantId % 1 ~= 0 then return false end
        if type(actorId) ~= "number" or actorId < 1 or actorId > 4294967295 or actorId % 1 ~= 0 then return false end
        if type(generation) ~= "number" or generation < 1 or generation > 65535 or generation % 1 ~= 0 then return false end
        if type(characterName) ~= "string" or characterName == "" then return false end

        local combatants = ReplicatedStorage:FindFirstChild("Combatants")
        local descriptor = combatants and combatants:FindFirstChild(tostring(combatantId))
        if not descriptor or not descriptor:IsA("Folder") then return false end
        if descriptor:GetAttribute("CombatantId") ~= combatantId then return false end
        if descriptor:GetAttribute("ActorId") ~= actorId then return false end
        if descriptor:GetAttribute("Generation") ~= generation then return false end
        if descriptor:GetAttribute("CharacterName") ~= characterName then return false end
        if descriptor:GetAttribute("DisplayName") ~= model.Name then return false end
        local descriptorTeam = descriptor:GetAttribute("Team")
        local shellTeam = model:GetAttribute("Team")
        if type(descriptorTeam) ~= "string" or descriptorTeam ~= shellTeam then return false end
        if descriptor:GetAttribute("Dead") ~= false then return false end
        local descriptorHealth = descriptor:GetAttribute("Health")
        local maxHealth = descriptor:GetAttribute("MaxHealth")
        local shellMaxHealth = model:GetAttribute("MaxHealth")
        if type(descriptorHealth) ~= "number" or descriptorHealth <= 0 then return false end
        if type(maxHealth) ~= "number" or maxHealth <= 0 then return false end
        if type(shellMaxHealth) ~= "number" or shellMaxHealth <= 0 then return false end
        if descriptorHealth > maxHealth then return false end
        return true
    end

    local function getVisibleShell(player)
        if not player then return nil end
        local uid = player.UserId
        local now = os.clock()
        local cached = VisibleShellCache[uid]
        local cacheAge = now - (VisibleShellCacheAt[uid] or 0)
        if cached == NO_VISIBLE_SHELL and cacheAge < VISIBLE_CACHE_TTL then return nil end
        if cached and cached ~= NO_VISIBLE_SHELL and cacheAge < VISIBLE_CACHE_TTL
            and isValidPlayerShell(player, cached) then
            return cached
        end

        VisibleShellCache[uid] = nil
        VisibleShellCacheAt[uid] = 0
        local found = nil
        local character = player.Character
        if isValidPlayerShell(player, character) then
            found = character
        else
            -- ClientCharacterPresentation nomeia o shell com player.Name.
            -- Procura diretamente pelo nome, em vez de percorrer todos os modelos.
            local folder = workspace:FindFirstChild("Characters")
            local candidate = (folder and folder:FindFirstChild(player.Name)) or workspace:FindFirstChild(player.Name)
            if candidate and candidate:GetAttribute(OWNER_ATTR) == uid
                and isValidPlayerShell(player, candidate) then
                found = candidate
            end
        end
        VisibleShellCache[uid] = found or NO_VISIBLE_SHELL
        VisibleShellCacheAt[uid] = now
        return found
    end

    local function getAllBotShells()
        local now = os.clock()
        if (now - BotShellCacheAt) < BOT_CACHE_TTL then return BotShellCache end
        local bots = {}
        local folder = workspace:FindFirstChild("Characters")
        local candidates = folder and folder:GetChildren() or workspace:GetChildren()
        for _, model in ipairs(candidates) do
            if model:IsA("Model") and isValidBotShell(model) then
                bots[#bots + 1] = model
            end
        end
        BotShellCache = bots
        BotShellCacheAt = now
        return BotShellCache
    end

    NIGHT_TrackConnection(Players.PlayerRemoving:Connect(function(player)
        VisibleShellCache[player.UserId] = nil
        VisibleShellCacheAt[player.UserId] = nil
    end))

    local function isShellAlive(shell)
        if not shell or not shell:IsA("Model") then return false end
        if not shell:IsDescendantOf(workspace) then return false end
        if shell:GetAttribute(VISIBLE_ATTR) ~= true then return false end
        if shell:GetAttribute("Dead") == true then return false end
        if shell:GetAttribute("TutorialDummy") == true or shell:GetAttribute("TutorialCutout") == true then return false end
        local hp = shell:GetAttribute("Health")
