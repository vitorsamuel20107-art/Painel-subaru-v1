    local function HitSound_Play()
        if not HitSoundEnabled or type(isfile) ~= "function"
            or type(getcustomasset) ~= "function" then return end
        local okFile, exists = pcall(isfile, HitSoundFile)
        if not okFile or not exists then return end
        local okAsset, assetId = pcall(getcustomasset, HitSoundFile)
        if not okAsset or type(assetId) ~= "string" then return end

        local sound = Instance.new("Sound")
        sound.SoundId = assetId
        sound.Volume = HitSoundVolume
        sound.Parent = SoundService
        sound:Play()
        sound.Ended:Once(function()
            if sound.Parent then sound:Destroy() end
        end)
        task.delay(6, function()
            if sound.Parent then sound:Destroy() end
        end)
    end

    local HitSoundListenerStarted = false
    local HitSoundConnection = nil
    local HitSoundLookupFailed = false

    local function HitSound_EnsureListener()
        if HitSoundListenerStarted or HitSoundLookupFailed or not HitSoundEnabled then return end
        HitSoundListenerStarted = true

        -- Caminho específico confirmado pelo usuário. Não varre NetworkRemotes,
        -- não usa getgc e não fica repetindo a busca se o evento não existir.
        local ok, result = pcall(function()
            local security = ReplicatedStorage:FindFirstChild("Database")
            security = security and security:FindFirstChild("Security")
            local remotesModule = security and security:FindFirstChild("Remotes")
            if not remotesModule or not remotesModule:IsA("ModuleScript") then
                return false
            end

            local Remotes = require(remotesModule)
            local ui = type(Remotes) == "table" and Remotes.UI
            local killed = type(ui) == "table" and ui.UIPlayerKilled
            if type(killed) ~= "table" or type(killed.Listen) ~= "function" then
                return false
            end

            killed.Listen(function(data)
                if not NIGHT_IsCurrent() or not HitSoundEnabled or type(data) ~= "table" or data.Killer == nil then return end
                if tostring(data.Killer) == tostring(LocalPlayer.UserId) then
                    HitSound_Play()
                end
            end)
            return true
        end)

        if not ok or result ~= true then
            HitSoundLookupFailed = true
            HitSoundListenerStarted = false
            warn("[NIGHT] Hit Sound: UIPlayerKilled.Listen não encontrado; busca encerrada.")
        end
    end

