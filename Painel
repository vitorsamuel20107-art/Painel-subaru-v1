    local NoRecoil_Props = {
        "BaseSpread", "MaxSpread", "MinSpread", "ChargeStartSpread", 
        "LastSpreadValue", "RecoilUp", "RecoilDown", "RecoilLeft", "RecoilRight", "Kick",
        "Spread", "Sway", "Inaccuracy", "SpreadIncrement", "SwayBase", "fSpringPitch", "fSpringYaw"
    }
    local NoRecoil_TrackedTables = {}
    local NoRecoil_HookedFunctions = {}
    local cameraShakeHooked = false

    local function NoRecoil_FastClear(t)
        for i = 1, #NoRecoil_Props do
            local prop = NoRecoil_Props[i]
            local v = rawget(t, prop)
            if v ~= nil then
                if type(v) == "number" then
                    rawset(t, prop, 0.00001)
                elseif type(v) == "table" then
                    for k, val in pairs(v) do
                        if type(val) == "number" then rawset(v, k, 0.00001)
                        elseif typeof(val) == "Vector3" then rawset(v, k, Vector3.new(0, 0, 0))
                        elseif typeof(val) == "Vector2" then rawset(v, k, Vector2.new(0, 0)) end
                    end
                end
            end
        end
        if rawget(t, "Follow Recoil") ~= nil then rawset(t, "Follow Recoil", false) end
    end

    NIGHT_TrackConnection(RunService.RenderStepped:Connect(function()
        if not NIGHT_IsCurrent() or not NoRecoilEnabled then return end
        for t, _ in pairs(NoRecoil_TrackedTables) do NoRecoil_FastClear(t) end
    end))

    local function NoRecoil_HookCamera()
        if cameraShakeHooked then return end
        cameraShakeHooked = true
        local controllers = ReplicatedStorage:FindFirstChild("Controllers")
        if controllers then
            local cameraControllerModule = controllers:FindFirstChild("CameraController")
            if cameraControllerModule then
                local success, camController = pcall(require, cameraControllerModule)
                if success and type(camController) == "table" then
                    for k, v in pairs(camController) do
                        if type(v) == "function" then
                            local lowerName = string.lower(tostring(k))
                            if lowerName:find("recoil") or lowerName:find("shake") or lowerName:find("kick") then
                                hookfunction(v, function(...) return end)
                            end
                        end
                    end
                end
            end
        end
    end

    -- Busca apenas os módulos conhecidos do dump, sem enumeração global de memória.
    local NoRecoilScanAttempted = false
    local function NoRecoil_ScanAndNeutralize()
        if NoRecoilScanAttempted then return end
        NoRecoilScanAttempted = true

        local function requirePath(parent, name)
            local obj = parent and parent:FindFirstChild(name)
            if not obj or not obj:IsA("ModuleScript") then return nil end
            local ok, result = pcall(require, obj)
            if ok and type(result) == "table" then return result end
            return nil
        end
        local components = ReplicatedStorage:FindFirstChild("Components")
        local controllers = ReplicatedStorage:FindFirstChild("Controllers")
        local weaponMod = requirePath(components, "Weapon")
        local cameraMod = requirePath(controllers, "CameraController")
        local weaponFolder = components and components:FindFirstChild("Weapon")
        local classes = weaponFolder and weaponFolder:FindFirstChild("Classes")
        local bulletMod = requirePath(classes, "Bullet")

        local function hookKnownExports(mod)
            if not mod then return end
            for name, fn in pairs(mod) do
                if type(fn) == "function" and not NoRecoil_HookedFunctions[fn] then
                    local replacement = nil
                    if name == "getSpread" or name == "getTrueSpread" or name == "getSpreadForConfig"
                        or name == "getBaseSpread" or name == "getBaseSpreadForConfig"
                        or name == "getMovementSpreadForConfig" then
                        replacement = function(...) return 0.00001 end
                    elseif name == "getWeaponRecoil" or name == "CameraControllerGetWeaponRecoil" then
                        replacement = function(...) return CFrame.new(), Vector3.zero, 0 end
                    elseif name == "_updateShotSpread" or name == "updateSpread"
                        or name == "setWeaponRecoil" or name == "setupRecoil" then
                        replacement = function(...) return end
                    elseif name == "GetRecoilAssistMultiplier" then
                        replacement = function(...) return 0 end
                    end
                    if replacement then
                        local ok = pcall(function() hookfunction(fn, replacement) end)
                        if ok then NoRecoil_HookedFunctions[fn] = true end
                    end
                end
            end
        end
        hookKnownExports(weaponMod)
        hookKnownExports(cameraMod)
        hookKnownExports(bulletMod)
    end

