local function CriarHUD()
    local VERSAO = "v1.1.0"
    local ALTURA_REF = 1080
    local COR_VERSAO = Color3.fromRGB(255, 199, 116)
    local COR_FUNDO = Color3.fromRGB(0, 0, 0)
    local TRANSP_FUNDO = 0.9
    local COR_LABEL = Color3.fromRGB(225, 225, 225)
    local COR_VALOR = Color3.fromRGB(255, 255, 255)
    local FONTE_REGULAR = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
    local FONTE_VERSAO = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
    local LARGURA_HOLDER = 700
    local ALTURA_PILULA = 36
    local MARGEM_TOPO = 13
    local MARGEM_DIREITA = 12
    local ESPACO = 5
    local TAM_TEXTO = 28
    local TAM_VERSAO = 24
    local RAIO = 8
    local LARGURAS = { FPS = 149, PING = 181, REGION = 171 }
    local PAD_ESQ = { FPS = 26, PING = 28, REGION = 29 }
    local INTERVALO = 1

    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    for _, oldGui in ipairs(playerGui:GetChildren()) do
        if oldGui:IsA("ScreenGui")
            and (oldGui.Name == "HUDDesempenho" or oldGui.Name == "NIGHT_FFH4X_HUD") then
            oldGui:Destroy()
        end
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "NIGHT_FFH4X_HUD"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 100
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = playerGui
    NIGHT_TrackInstance(gui)

    local holder = Instance.new("Frame")
    holder.Name = "Holder"
    holder.BackgroundTransparency = 1
    holder.AnchorPoint = Vector2.new(1, 0)
    holder.Position = UDim2.new(1, 0, 0, 0)
    holder.Size = UDim2.fromOffset(LARGURA_HOLDER, MARGEM_TOPO + ALTURA_PILULA)
    holder.Parent = gui

    local escala = Instance.new("UIScale")
    escala.Parent = holder
    local function atualizarEscala() escala.Scale = math.max(gui.AbsoluteSize.Y, 1) / ALTURA_REF end
    atualizarEscala()
    table.insert(NIGHT_Connections, gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(atualizarEscala))

    local function criarPilula(nome, xFinal)
        local largura = LARGURAS[nome]
        local caixa = Instance.new("Frame")
        caixa.Name = nome caixa.BackgroundColor3 = COR_FUNDO caixa.BackgroundTransparency = TRANSP_FUNDO caixa.BorderSizePixel = 0
        caixa.Size = UDim2.fromOffset(largura, ALTURA_PILULA) caixa.Position = UDim2.fromOffset(xFinal - largura, MARGEM_TOPO) caixa.Parent = holder
        Instance.new("UICorner", caixa).CornerRadius = UDim.new(0, RAIO)
        local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, PAD_ESQ[nome]); pad.Parent = caixa
        local texto = Instance.new("TextLabel")
        texto.Name = "Texto" texto.BackgroundTransparency = 1 texto.Size = UDim2.fromScale(1, 1) texto.FontFace = FONTE_REGULAR
        texto.TextSize = TAM_TEXTO texto.TextColor3 = COR_LABEL texto.RichText = true
        texto.TextXAlignment = Enum.TextXAlignment.Left texto.TextYAlignment = Enum.TextYAlignment.Center texto.Parent = caixa
        return texto
    end

    local xRegion = LARGURA_HOLDER - MARGEM_DIREITA
    local xPing = xRegion - LARGURAS.REGION - ESPACO
    local xFps = xPing - LARGURAS.PING - ESPACO
    local xVersao = xFps - LARGURAS.FPS - 18

    local txtRegion = criarPilula("REGION", xRegion)
    local txtPing = criarPilula("PING", xPing)
    local txtFps = criarPilula("FPS", xFps)

    local txtVersao = Instance.new("TextLabel")
    txtVersao.Name = "Versao" txtVersao.BackgroundTransparency = 1 txtVersao.Size = UDim2.fromOffset(90, ALTURA_PILULA)
    txtVersao.Position = UDim2.fromOffset(xVersao - 90, MARGEM_TOPO) txtVersao.FontFace = FONTE_VERSAO
    txtVersao.Text = VERSAO txtVersao.TextSize = TAM_VERSAO txtVersao.TextColor3 = COR_VERSAO
    txtVersao.TextXAlignment = Enum.TextXAlignment.Right txtVersao.Parent = holder

    local hexLabel = COR_LABEL:ToHex()
    local function montarComCor(label, valor, corHex)
        return string.format('<font color="#%s">%s</font> <font color="#%s"><b>%s</b></font>', hexLabel, label, corHex, valor)
    end
    local function lerPing()
        local ms = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        if not ms then ms = LocalPlayer:GetNetworkPing() * 2000 end
        return math.floor(ms + 0.5)
    end
    local function lerRegiao()
        local codigoServidor = workspace:GetAttribute("ServerRegion")
        if codigoServidor and codigoServidor ~= "" then return string.upper(tostring(codigoServidor)) end
        local pais = LocalizationService:GetCountryRegionForPlayerAsync(LocalPlayer)
        if pais and pais ~= "" then
            local mapa = { ["BR"]="BR",["BRA"]="BR",["US"]="US",["USA"]="US",["CA"]="US",["DE"]="EU",["FR"]="EU",["GB"]="EU",["IT"]="EU",["JP"]="ASIA",["SG"]="ASIA",["KR"]="ASIA" }
            local regiao = mapa[pais] or pais:upper()
            if regiao and regiao ~= "" then return regiao end
        end
        return "UNKNOWN"
    end
    local function atualizarRegiao() txtRegion.Text = montarComCor("REGION", lerRegiao(), COR_VALOR:ToHex()) end
    atualizarRegiao()
    table.insert(NIGHT_Connections, workspace:GetAttributeChangedSignal("ServerRegion"):Connect(atualizarRegiao))

    local frames, tempo = 0, 0
    txtFps.Text = montarComCor("FPS", "--", COR_VALOR:ToHex())
    txtPing.Text = montarComCor("PING", "--ms", COR_VALOR:ToHex())

    table.insert(NIGHT_Connections, RunService.RenderStepped:Connect(function(dt)
        frames = frames + 1 tempo = tempo + dt
        if tempo >= INTERVALO then
            local fpsVal = math.floor(frames / tempo + 0.5)
            local fpsCorHex = fpsVal < 29 and "FF0000" or (fpsVal < 60 and "FFFF00" or "00FF00")
            txtFps.Text = montarComCor("FPS", tostring(fpsVal), fpsCorHex)
            local pingVal = lerPing()
            local pingCorHex = pingVal >= 180 and "FF0000" or (pingVal >= 80 and "FFFF00" or "00FF64")
            txtPing.Text = montarComCor("PING", pingVal .. "ms", pingCorHex)
            frames, tempo = 0, 0
        end
    end))
end

