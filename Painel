-- Resolve módulos/instâncias por caminho conhecido do BloxStrike.
-- Cada módulo é carregado somente quando a respectiva opção é ativada.
local NIGHT_ModuleCache = {}
local NIGHT_MODULE_NOT_FOUND = {}
local function NIGHT_FindReplicatedInstance(path)
    local current = ReplicatedStorage
    for segment in string.gmatch(path, "[^%.]+") do
        current = current and current:FindFirstChild(segment)
        if not current then return nil end
    end
    return current
end

local function NIGHT_RequireGameModule(path)
    local cached = NIGHT_ModuleCache[path]
    if cached ~= nil then
        if cached == NIGHT_MODULE_NOT_FOUND then return nil end
        return cached
    end

    -- Busca somente o caminho informado. Resultado negativo também fica em cache:
    -- não repete FindFirstChild/require a cada troca de arma ou atualização.
    local moduleScript = NIGHT_FindReplicatedInstance(path)
    if not moduleScript or not moduleScript:IsA("ModuleScript") then
        NIGHT_ModuleCache[path] = NIGHT_MODULE_NOT_FOUND
        return nil
    end

    local ok, result = pcall(require, moduleScript)
    if not ok or result == nil then
        NIGHT_ModuleCache[path] = NIGHT_MODULE_NOT_FOUND
        warn("[NIGHT] Módulo opcional indisponível (busca encerrada):", path)
        return nil
    end

    NIGHT_ModuleCache[path] = result
    return result
end

