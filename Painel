    -- MOONWALK + SPIN BOT (FLICKER) — integrados aos checkboxes Rage
    -- Moonwalk: yaw invertido em 180°, preservando a direção do movimento.
    -- Spin Bot: alterna yaw normal/invertido em frequência configurada.
    -- ======================================================================
    local MoonwalkEnabled = GlobalSettings.Toggles["moonwalk"] == true
    local SpinBotEnabled = GlobalSettings.Toggles["spin bot"] == true
    local MoonwalkHooked = false
    local MoonwalkHookPending = false
    local MoonwalkFlickerHz = 4

    local function Moonwalk_HookPrepareInput()
        if MoonwalkHooked then return true end
        local charModule = NIGHT_RequireGameModule("Classes.Character")
        if type(charModule) ~= "table" then return false end
        local originalPrepareInputFrame = rawget(charModule, "PrepareInputFrame")
        if type(originalPrepareInputFrame) ~= "function" then return false end
        if rawget(charModule, "_NIGHT_MoonwalkHooked") == true then
            MoonwalkHooked = true
            return true
        end

        local replacement = function(charObject, ...)
            local results = table.pack(originalPrepareInputFrame(charObject, ...))
            if not (MoonwalkEnabled or SpinBotEnabled) then
                return table.unpack(results, 1, results.n)
            end
            pcall(function()
                local realYaw = charObject.CurrentFrameLookYaw or 0
                local targetYaw = realYaw
                if SpinBotEnabled then
                    local period = math.max(1, math.floor(60 / MoonwalkFlickerHz))
                    local frameIndex = math.floor(tick() * 60) % (period * 2)
                    if frameIndex >= period then targetYaw = realYaw + math.pi end
                elseif MoonwalkEnabled then
                    targetYaw = realYaw + math.pi
                end
                targetYaw = ((targetYaw + math.pi) % (2 * math.pi)) - math.pi
                charObject.CurrentFrameLookYaw = targetYaw
                charObject.PreviousFrameLookYaw = targetYaw - math.rad(0.1)
                local moveVector = charObject.CurrentFrameMoveVector
                if moveVector and moveVector.Magnitude > 0.01 then
                    local offset = realYaw - targetYaw
                    local cosine, sine = math.cos(offset), math.sin(offset)
                    charObject.CurrentFrameMoveVector = Vector2.new(
                        moveVector.X * cosine - moveVector.Y * sine,
                        moveVector.X * sine + moveVector.Y * cosine
                    )
                end
            end)
            return table.unpack(results, 1, results.n)
        end
        if type(newcclosure) == "function" then
            local ok, wrapped = pcall(newcclosure, replacement)
            if ok and type(wrapped) == "function" then replacement = wrapped end
        end
        local ok = pcall(function()
            charModule.PrepareInputFrame = replacement
            charModule._NIGHT_MoonwalkHooked = true
        end)
        MoonwalkHooked = ok
        if ok then print("[NIGHT] Moonwalk: módulo Character hookado") end
        return ok
    end

    local function Moonwalk_EnsureHook()
        if MoonwalkHooked or MoonwalkHookPending or not (MoonwalkEnabled or SpinBotEnabled) then return end
        MoonwalkHookPending = true
        task.spawn(function()
            task.wait(1)
            -- Uma única tentativa no módulo conhecido; sem repetição se não existir.
            Moonwalk_HookPrepareInput()
            MoonwalkHookPending = false
        end)
    end

