    -- ============ NO SMOKE / NO FLASH LOGIC ============
    local NoSmoke_Enabled  = GlobalSettings.Toggles["Sem Smoke"]   == true
    local NoFlash_Enabled  = GlobalSettings.Toggles["Sem Flash"]   == true

    -- Estado dos hooks (evita re-hookar)
    local _flashBurstHooked   = false
    local _flashEffectHooked  = false
    local _flashCaptureHooked = false
    local _flashSoundHooked   = false
    local _noSmokeConnected   = false
    local _noSmokeConn        = nil
    local _processedSmoke     = setmetatable({}, { __mode = "k" })

    -- FLASH — hooks direcionados aos ModuleScripts exatos do dump do jogo.
    local function _wrapNoFlash(fn)
        if type(newcclosure) == "function" then
            local ok, wrapped = pcall(newcclosure, fn)
            if ok and type(wrapped) == "function" then return wrapped end
        end
        return fn
    end

    local function _hookGrenadeBurst()
        if _flashBurstHooked then return true end
        if type(hookfunction) ~= "function" then return false end
        local burstFunction = NIGHT_RequireGameModule("Components.Common.VFXLibary.CreateGrenadeBurst")
        if type(burstFunction) ~= "function" then return false end
        local ok = pcall(hookfunction, burstFunction, _wrapNoFlash(function(...) return nil end))
        _flashBurstHooked = ok
        return ok
    end

    local function _hookFlashEffect()
        if _flashEffectHooked then return true end
        local flashModule = NIGHT_RequireGameModule("Components.Common.VFXLibary.FlashEffect")
        if type(flashModule) ~= "table" then return false end
        if type(rawget(flashModule, "Flash")) ~= "function" then return false end
        rawset(flashModule, "Flash", _wrapNoFlash(function(...) return false end))
        rawset(flashModule, "IsFlashed", _wrapNoFlash(function(...) return false end))
        rawset(flashModule, "CancelFlash", _wrapNoFlash(function(...) return nil end))
        _flashEffectHooked = true
        return true
    end

    local function _hookCapture()
        if _flashCaptureHooked then return true end
        local captureModule = NIGHT_RequireGameModule("Controllers.CaptureController")
        if type(captureModule) ~= "table" or type(rawget(captureModule, "CaptureScreenshot")) ~= "function" then
            return false
        end
        rawset(captureModule, "CaptureScreenshot", _wrapNoFlash(function(callback)
            if type(callback) == "function" then task.defer(callback, "") end
            local chain = {}
            function chain:catch(_) return self end
            function chain:andThen(nextCallback)
                if type(nextCallback) == "function" then task.defer(nextCallback, "") end
                return self
            end
            return chain
        end))
        _flashCaptureHooked = true
        return true
    end

    -- FLASH — camada 4: GUI / ColorCorrection fallback
    local _flashGuiConn, _flashLightConn
    local function _killFlashGUIs()
        for _, sg in ipairs(LocalPlayer:WaitForChild("PlayerGui"):GetChildren()) do
            if sg.Name == "FlashbangEffect" or sg.Name == "FlashScreenshot" then
                pcall(function() sg:Destroy() end)
