    -- SMOKE — o jogo cria fumaça/efeitos temporários em Workspace.Debris.
    -- Processa somente esse container, em lotes, sem varrer o Workspace inteiro.
    local _smokeRoot = nil
    local _smokeRootWatchConn = nil
    local _smokeRemovingConn = nil
    local _smokeOriginals = setmetatable({}, { __mode = "k" })

    local function _killEmitter(obj)
        if not obj or not obj.Parent then return end
        if not (obj:IsA("ParticleEmitter") or obj:IsA("Smoke")
            or obj:IsA("Fire") or obj:IsA("Sparkles")) then return end
        if not _smokeOriginals[obj] then
            local snapshot = {}
            pcall(function() snapshot.Enabled = obj.Enabled end)
            if obj:IsA("ParticleEmitter") then
                pcall(function() snapshot.Rate = obj.Rate end)
                pcall(function() snapshot.Transparency = obj.Transparency end)
            end
            _smokeOriginals[obj] = snapshot
        end
        pcall(function()
            obj.Enabled = false
            if obj:IsA("ParticleEmitter") then
                obj.Rate = 0
                obj.Transparency = NumberSequence.new(1)
            end
        end)
        _processedSmoke[obj] = true
    end

    local function _restoreSmokeEmitter(obj, snapshot)
        if not obj or not snapshot then return end
        pcall(function()
            if snapshot.Enabled ~= nil then obj.Enabled = snapshot.Enabled end
            if snapshot.Rate ~= nil and obj:IsA("ParticleEmitter") then obj.Rate = snapshot.Rate end
            if snapshot.Transparency ~= nil and obj:IsA("ParticleEmitter") then obj.Transparency = snapshot.Transparency end
        end)
    end

    local function _connectSmokeRoot(root)
        if not root or _smokeRoot == root then return end
        if _noSmokeConn then _noSmokeConn:Disconnect(); _noSmokeConn = nil end
        if _smokeRemovingConn then _smokeRemovingConn:Disconnect(); _smokeRemovingConn = nil end
        _smokeRoot = root
        _noSmokeConn = NIGHT_TrackConnection(root.DescendantAdded:Connect(function(obj)
            if NoSmoke_Enabled then task.defer(_killEmitter, obj) end
        end))
        _smokeRemovingConn = NIGHT_TrackConnection(root.DescendantRemoving:Connect(function(obj)
            _processedSmoke[obj] = nil
        end))
        task.spawn(function()
            local stack = { root }
            local processed = 0
            while #stack > 0 and NoSmoke_Enabled and _smokeRoot == root and NIGHT_IsCurrent() do
                local obj = stack[#stack]
                stack[#stack] = nil
                if obj ~= root then _killEmitter(obj) end
                local children = obj:GetChildren()
                for i = 1, #children do stack[#stack + 1] = children[i] end
                processed = processed + 1
                if processed % 120 == 0 then task.wait() end
            end
        end)
    end

    local function ApplyNoSmoke()
        if not NoSmoke_Enabled then return end
        local debrisRoot = Workspace:FindFirstChild("Debris")
        if debrisRoot then _connectSmokeRoot(debrisRoot) end
        if not _smokeRootWatchConn then
            _smokeRootWatchConn = NIGHT_TrackConnection(Workspace.ChildAdded:Connect(function(child)
                if NoSmoke_Enabled and child.Name == "Debris" then _connectSmokeRoot(child) end
            end))
        end
    end

    local function RestoreNoSmoke()
        if _noSmokeConn then _noSmokeConn:Disconnect(); _noSmokeConn = nil end
        if _smokeRemovingConn then _smokeRemovingConn:Disconnect(); _smokeRemovingConn = nil end
        if _smokeRootWatchConn then _smokeRootWatchConn:Disconnect(); _smokeRootWatchConn = nil end
        for obj, snapshot in pairs(_smokeOriginals) do
            _restoreSmokeEmitter(obj, snapshot)
            _smokeOriginals[obj] = nil
            _processedSmoke[obj] = nil
        end
        _smokeRoot = nil
        _noSmokeConnected = false
    end

    -- Inicializa se já estiver ativo nos saves
