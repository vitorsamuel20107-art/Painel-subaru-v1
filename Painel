    local function BulletTrail_CreateBeam()
        local folder = Instance.new("Folder")
        folder.Name = "NIGHT_Trail"
        folder.Parent = Workspace

        local anchor = Instance.new("Part")
        anchor.Name = "TrailAnchor"
        anchor.Size = Vector3.new(0.05, 0.05, 0.05)
        anchor.Transparency = 1
        anchor.Anchored = true
        anchor.CanCollide = false
        anchor.CanTouch = false
        anchor.CanQuery = false
        anchor.CastShadow = false
        anchor.Parent = folder

        local a0 = Instance.new("Attachment")
        a0.Name = "A0"
        a0.Parent = anchor

        local a1 = Instance.new("Attachment")
        a1.Name = "A1"
        a1.Parent = anchor

        local beam = Instance.new("Beam")
        beam.Name = "Trail"
        beam.Attachment0 = a0
        beam.Attachment1 = a1
        beam.Color = ColorSequence.new(BulletTrailCFG.Color0, BulletTrailCFG.Color1)
        beam.Width0 = BulletTrailCFG.Width0
        beam.Width1 = BulletTrailCFG.Width1
        beam.LightEmission = BulletTrailCFG.LightEmission
        beam.LightInfluence = BulletTrailCFG.LightInfluence
        beam.FaceCamera = BulletTrailCFG.FaceCamera
        beam.Segments = 1
        beam.CurveSize0 = 0
        beam.CurveSize1 = 0
        beam.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(0.4, 0.1),
            NumberSequenceKeypoint.new(0.8, 0.5),
            NumberSequenceKeypoint.new(1, 1),
        })
        beam.Enabled = false
        beam.Parent = folder
        return {folder = folder, a0 = a0, a1 = a1, beam = beam, inUse = false}
    end

    local function BulletTrail_AcquireBeam()
        for _, obj in ipairs(BulletTrailPool) do
            if not obj.inUse then
                obj.inUse = true
                return obj
            end
        end
        local obj = BulletTrail_CreateBeam()
        obj.inUse = true
        table.insert(BulletTrailPool, obj)
        return obj
    end

    local function BulletTrail_ReleaseBeam(obj)
        obj.beam.Enabled = false
        obj.inUse = false
    end

    local function BulletTrail_Draw(origin, impactPos)
        if not BulletTrailCFG.Enabled then return end
        local obj = BulletTrail_AcquireBeam()
        obj.a0.WorldPosition = origin
        obj.a1.WorldPosition = impactPos
        obj.beam.Width0 = BulletTrailCFG.Width0
        obj.beam.Width1 = BulletTrailCFG.Width1
        obj.beam.Enabled = true

        local startTime = os.clock()
        local duration = BulletTrailCFG.Duration
        local conn
        conn = RunService.RenderStepped:Connect(function()
            local elapsed = os.clock() - startTime
            if elapsed >= duration then
                conn:Disconnect()
                BulletTrail_ReleaseBeam(obj)
                return
            end
            local t = elapsed / duration
            obj.beam.Width0 = BulletTrailCFG.Width0 * (1 - t)
            obj.beam.Width1 = BulletTrailCFG.Width1 * (1 - t * 0.5)
            obj.beam.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, t * 0.2),
                NumberSequenceKeypoint.new(0.5, t * 0.5 + 0.1),
                NumberSequenceKeypoint.new(1, math.min(t + 0.3, 1)),
            })
        end)
    end

    local function BulletTrail_GetMuzzlePos()
        local cam = Workspace.CurrentCamera
        if not cam then return Vector3.zero end
        local vm = cam:FindFirstChild("Viewmodel") or cam:FindFirstChildWhichIsA("Model")
        if vm then
            local muzzle = vm:FindFirstChild("MuzzlePoint")
                or vm:FindFirstChild("Muzzle")
                or vm:FindFirstChild("BarrelEnd")
                or vm:FindFirstChild("GunPoint")
            if muzzle and muzzle:IsA("BasePart") then return muzzle.Position end
            if muzzle and muzzle:IsA("Attachment") then return muzzle.WorldPosition end
        end
        return cam.CFrame.Position + cam.CFrame.LookVector * 1.5
    end

    local function BulletTrail_SpawnMuzzleFlash(pos)
        if not BulletTrailCFG.MuzzleFlashEnabled then return end
        local part = Instance.new("Part")
        part.Name = "NIGHT_MuzzleFlash"
        part.Size = Vector3.new(BulletTrailCFG.MuzzleFlashSize, BulletTrailCFG.MuzzleFlashSize, BulletTrailCFG.MuzzleFlashSize)
        part.Position = pos
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CastShadow = false
        part.Transparency = 0.3
        part.Color = BulletTrailCFG.Color0
        part.Material = Enum.Material.Neon
        part.Parent = Workspace

        local light = Instance.new("PointLight")
        light.Color = BulletTrailCFG.Color0
        light.Brightness = 8
        light.Range = 10
        light.Parent = part
        BulletTrailDebris:AddItem(part, BulletTrailCFG.MuzzleFlashDuration)
    end

    local function BulletTrail_HookBullet()
        if BulletTrailHooked then return true end
        local bulletModule = NIGHT_RequireGameModule("Components.Weapon.Classes.Bullet")
        if type(bulletModule) ~= "table" then return false end
        local originalPerform = rawget(bulletModule, "_performRaycast")
        if type(originalPerform) ~= "function" then return false end
        local replacement = function(self, spread)
            local result = originalPerform(self, spread)
            if not result or not BulletTrailCFG.Enabled then return result end
            pcall(function()
                local origin = result.Origin
                local direction = result.Direction
                local distance = result.Distance or 500
                if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then return end
                if not LocalPlayer.Character then return end
                local muzzlePos = BulletTrail_GetMuzzlePos()
                BulletTrail_Draw(muzzlePos, origin + direction * distance)
                BulletTrail_SpawnMuzzleFlash(muzzlePos)
            end)
            return result
        end
        local wrapped = replacement
        if type(newcclosure) == "function" then
            local ok, closure = pcall(newcclosure, replacement)
            if ok and type(closure) == "function" then wrapped = closure end
        end
        local ok = pcall(rawset, bulletModule, "_performRaycast", wrapped)
        BulletTrailHooked = ok
        if ok then print("[NIGHT] Bullet Trail: módulo Bullet hookado") end
        return ok
    end

    local function BulletTrail_HookMuzzleFlashRemote()
        if BulletTrailRemoteHooked then return true end
        local remote = NIGHT_FindReplicatedInstance("NetworkRemotes.VFX.CreateCharacterMuzzleFlash")
        if not remote or not remote:IsA("RemoteEvent") then return false end
        NIGHT_TrackConnection(remote.OnClientEvent:Connect(function(data)
            if not BulletTrailCFG.Enabled or type(data) ~= "table" then return end
            local userId = data.UserId or data.userId
            if tostring(userId) ~= tostring(LocalPlayer.UserId) then return end
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local muzzlePos = BulletTrail_GetMuzzlePos()
            local impactPos = muzzlePos + cam.CFrame.LookVector * 300
            BulletTrail_Draw(muzzlePos, impactPos)
            BulletTrail_SpawnMuzzleFlash(muzzlePos)
        end))
        BulletTrailRemoteHooked = true
        print("[NIGHT] Bullet Trail: remote específico conectado")
        return true
    end

    local function BulletTrail_SetEnabled(enabled)
        BulletTrailEnabled = enabled == true
        BulletTrailCFG.Enabled = BulletTrailEnabled
        if not BulletTrailEnabled or BulletTrailStarted then return end
        BulletTrailStarted = true
        for i = 1, BulletTrailPoolSize do
            BulletTrailPool[i] = BulletTrail_CreateBeam()
        end
        task.spawn(function()
            task.wait(1.5)
            -- Cada hook faz uma busca pontual pelos módulos/remotes conhecidos.
            -- Se a função não existir, encerra sem polling ou nova varredura.
            pcall(BulletTrail_HookBullet)
            pcall(BulletTrail_HookMuzzleFlashRemote)
        end)
    end

