            if not player then return false end
            local dead = player:GetAttribute("Dead")
            if dead == true then return false end
            local hp = player:GetAttribute("Health")
            if type(hp) == "number" and hp <= 0 then return false end
            if dead == nil then
                if not player.Character then return false end
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                return hum and hum.Health > 0 and player.Character:FindFirstChild("HumanoidRootPart") ~= nil
            end
            return player.Character ~= nil and player.Character:FindFirstChild("HumanoidRootPart") ~= nil
        end
        local function GetDynamicTargetPart(character)
            if not character then return nil end
            return aimSilent_findPart(character, Aimbot_Settings.PullPart or "Head")
                or character:FindFirstChild("Head")
                or character:FindFirstChild("HumanoidRootPart")
        end
        local MagicRayParams = RaycastParams.new() MagicRayParams.FilterType = Enum.RaycastFilterType.Exclude MagicRayParams.IgnoreWater = true
        local function IsPartVisible(targetPart) if not Aimbot_Settings.VisibleCheck then return true end local origin = Camera.CFrame.Position MagicRayParams.FilterDescendantsInstances = {LocalPlayer.Character, targetPart.Parent} local hit = workspace:Raycast(origin, targetPart.Position - origin, MagicRayParams) return hit == nil end
        local function ApplyChams(character) if not character then return end local hl = character:FindFirstChild("NIGHT_Chams") or Instance.new("Highlight") hl.Name = "NIGHT_Chams" local targetColor = ESP_Settings.RainbowChams and Current_Rainbow_Color or ESP_Settings.ChamsColor hl.FillColor = targetColor hl.OutlineColor = targetColor hl.FillTransparency = 0.5 hl.OutlineTransparency = 0.1 if hl.Parent ~= character then hl.Parent = character end end

        local function hideDrawings(drawings, char)
            if not drawings then return end
            drawings.Name.Visible   = false
            drawings.Line.Visible   = false
            drawings.Box.Visible    = false
            drawings.Health.Visible = false
            for _, l in pairs(drawings.SkelLines) do l.Visible = false end
            drawings.SkelCircle.Visible = false
            if char then
                local hl = char:FindFirstChild("NIGHT_Chams")
                if hl then hl:Destroy() end
            end
        end

        local PlayerShellWatch = {}
        local function StopWatchingPlayerShell(player)
            local record = PlayerShellWatch[player]
            if not record then return end
            for _, connection in ipairs(record.Connections) do pcall(function() connection:Disconnect() end) end
            PlayerShellWatch[player] = nil
        end
        local function WatchPlayerShell(player, shell, drawings)
            local previous = PlayerShellWatch[player]
            if previous and previous.Shell == shell then return end
            StopWatchingPlayerShell(player)
            if not shell then return end
            local record = { Shell = shell, Connections = {} }
            local function invalidateIfInvalid()
                if not isValidPlayerShell(player, shell) or not isShellAlive(shell) then
                    ClearPlayerShellCache(player)
                    hideDrawings(drawings, shell)
                end
            end
            for _, attribute in ipairs({VISIBLE_ATTR, "Dead", "Health", OWNER_ATTR, CHARACTER_TYPE_ATTR, OWNED_ATTR}) do
                record.Connections[#record.Connections + 1] = shell:GetAttributeChangedSignal(attribute):Connect(invalidateIfInvalid)
            end
            record.Connections[#record.Connections + 1] = NIGHT_TrackConnection(shell.AncestryChanged:Connect(function()
                if not shell:IsDescendantOf(workspace) then
                    invalidateIfInvalid()
                end
            end))
            record.Connections[#record.Connections + 1] = NIGHT_TrackConnection(shell.Destroying:Connect(invalidateIfInvalid))
            PlayerShellWatch[player] = record
        end
        NIGHT_TrackConnection(Players.PlayerRemoving:Connect(function(player)
            StopWatchingPlayerShell(player)
        end))


        local espAccumulator = 0
        NIGHT_TrackConnection(RunService.RenderStepped:Connect(function(dt)
            if not NIGHT_IsCurrent() then return end
            Camera = workspace.CurrentCamera or Camera
            Current_Rainbow_H = (Current_Rainbow_H + (dt * Rainbow_Speed)) % 1
            Current_Rainbow_Color = Color3.fromHSV(Current_Rainbow_H, 1, 1)
            if GlobalSettings.ThemeHex == "RAINBOW" then
                for _, obj in ipairs(ThemeElements.Backgrounds) do if obj then obj.BackgroundColor3 = Current_Rainbow_Color end end
                for _, obj in ipairs(ThemeElements.Strokes) do if obj then obj.Color = Current_Rainbow_Color end end
                for _, obj in ipairs(ThemeElements.Texts) do if obj then obj.TextColor3 = Current_Rainbow_Color end end
                if ChatBox then ChatBox.ScrollBarImageColor3 = Current_Rainbow_Color end
            end

            espAccumulator = espAccumulator + dt
            if espAccumulator < 0.05 then return end -- ESP até 20 Hz; não limita o FPS do jogo.
            espAccumulator = 0
            local localIsAlive = IsAlive(LocalPlayer) local isChamsActive = ESP_Settings.Boxes and ESP_Settings.BoxType == "Chams Glow" local shouldDrawSkeleton = ESP_Settings.Skeleton and not isChamsActive
            
            -- Somente modelos presentes e validados no roster atual de bots.
            local activeBotShells = (FunctionsEnabled and localIsAlive) and getAllBotShells() or {}
            local activeBotSet = {}
            for _, botShell in ipairs(activeBotShells) do activeBotSet[botShell] = true end
            for shell in pairs(BotDrawings) do
                if not activeBotSet[shell] or not isValidBotShell(shell) then
                    RemoveBotDrawings(shell)
                end
            end

            if FunctionsEnabled and localIsAlive then
                local cBox  = ESP_Settings.BoxColor  == "RAINBOW" and Current_Rainbow_Color or fromHex(ESP_Settings.BoxColor)
                local cName = ESP_Settings.NameColor == "RAINBOW" and Current_Rainbow_Color or fromHex(ESP_Settings.NameColor)
                for _, botShell in ipairs(activeBotShells) do
                    if not isValidBotShell(botShell) then
                        HideBotDrawings(botShell)
                        continue
                    end
                    if ESP_Settings.TeamCheck then
                        local myTeam  = LocalPlayer:GetAttribute("Team")
                        local botTeam = botShell:GetAttribute("Team")
                        if myTeam and botTeam and myTeam == botTeam then HideBotDrawings(botShell) continue end
                    end
                    local hrp = botShell:FindFirstChild("HumanoidRootPart")
                    if not hrp then HideBotDrawings(botShell) continue end
                    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if not onScreen or pos.Z <= 0 then HideBotDrawings(botShell) continue end
                    local distance = (hrp.Position - Camera.CFrame.Position).Magnitude
                    if distance > ESP_Settings.MaxDistance then HideBotDrawings(botShell) continue end
                    local bounds = GetScreenBounds(botShell)
                    if not bounds then HideBotDrawings(botShell) continue end
                    local sizeX, sizeY = bounds.Width, bounds.Height

                    local d = GetOrCreateBotDrawings(botShell)

                    if ESP_Settings.Boxes and ESP_Settings.BoxType == "Quadrado" then
                        d.Box.Size     = Vector2.new(sizeX, sizeY)
                        d.Box.Position = Vector2.new(bounds.Left, bounds.Top)
                        d.Box.Color    = cBox
                        d.Box.Visible  = true
                    else
                        d.Box.Visible = false
                    end

                    if ESP_Settings.Names then
                        local sz = math.clamp(math.floor(800 / math.max(pos.Z, 1)), 9, 13)
                        d.Name.Text     = botShell.Name
                        d.Name.Color    = cName
                        d.Name.Size     = sz
                        d.Name.Position = Vector2.new(bounds.CenterX, bounds.Top - sz - 5)
                        d.Name.Visible  = true
                    else
                        d.Name.Visible = false
                    end

                    if ESP_Settings.Health then
                        local hp    = botShell:GetAttribute("Health") or 100
                        local maxHp = math.max(botShell:GetAttribute("MaxHealth") or 100, 1)
                        local pct   = math.clamp(hp / maxHp, 0, 1)
                        local offset = 4
                        d.Health.From      = Vector2.new(bounds.Left - offset, bounds.Bottom)
                        d.Health.To        = Vector2.new(bounds.Left - offset, bounds.Bottom - sizeY * pct)
                        d.Health.Color     = pct >= 0.7 and Color3.fromRGB(0,255,0) or (pct >= 0.4 and Color3.fromRGB(255,255,0) or Color3.fromRGB(255,0,0))
                        d.Health.Visible   = true
                    else
                        d.Health.Visible = false
                    end
                end
            end
            -- ────────────────────────────────────────────────────────────────


            for player, drawings in pairs(PlayerDrawings) do
                local shell = getVisibleShell(player)
                if shell then
                    WatchPlayerShell(player, shell, drawings)
                else
                    StopWatchingPlayerShell(player)
                end
                local isTargetAlive = shell and isValidPlayerShell(player, shell) and isShellAlive(shell)
                if FunctionsEnabled and localIsAlive and isTargetAlive and ValidarAlvoESP(player) then
                    local char = shell
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    -- sem HRP → esconde imediatamente (antes não havia hide aqui)
                    if not hrp then hideDrawings(drawings, char) continue end
                    if true then -- bloco de escopo
                        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                        local distance = (hrp.Position - Camera.CFrame.Position).Magnitude
                        local bounds = GetScreenBounds(char)
                        local highlight = char:FindFirstChild("NIGHT_Chams")

                        if onScreen and pos.Z > 0 and distance <= ESP_Settings.MaxDistance and bounds then
                            local cLine = ESP_Settings.LineColor == "RAINBOW" and Current_Rainbow_Color or fromHex(ESP_Settings.LineColor)
                            local cBox = ESP_Settings.BoxColor == "RAINBOW" and Current_Rainbow_Color or fromHex(ESP_Settings.BoxColor)
                            local cSkel = ESP_Settings.SkeletonColor == "RAINBOW" and Current_Rainbow_Color or fromHex(ESP_Settings.SkeletonColor)
                            local cName = ESP_Settings.NameColor == "RAINBOW" and Current_Rainbow_Color or fromHex(ESP_Settings.NameColor)

                            if ESP_Settings.Names then
                                drawings.Name.Visible = true drawings.Name.Text = player.Name drawings.Name.Color = cName
                                local calculatedSize = math.clamp(math.floor(bounds.Height * 0.12), 9, 13)
                                drawings.Name.Size = calculatedSize
                                drawings.Name.Position = Vector2.new(bounds.CenterX, bounds.Top - calculatedSize - 5)
                            else drawings.Name.Visible = false end

                            drawings.Line.Visible = ESP_Settings.Lines drawings.Line.From = Vector2.new(Camera.ViewportSize.X / 2, (ESP_Settings.LineOrigin == "Cima") and 0 or Camera.ViewportSize.Y) drawings.Line.To = Vector2.new(bounds.CenterX, bounds.Bottom) drawings.Line.Color = cLine drawings.Line.Thickness = 1
                            if ESP_Settings.Boxes then if ESP_Settings.BoxType == "Quadrado" then drawings.Box.Visible = true local sizeX, sizeY = bounds.Width, bounds.Height drawings.Box.Size = Vector2.new(sizeX, sizeY) drawings.Box.Position = Vector2.new(bounds.Left, bounds.Top) drawings.Box.Color = cBox drawings.Box.Thickness = 1 drawings.Box.Filled = false if highlight then highlight:Destroy() end elseif ESP_Settings.BoxType == "Chams Glow" then drawings.Box.Visible = false ApplyChams(char) end else drawings.Box.Visible = false if highlight then highlight:Destroy() end end
                            
                            if ESP_Settings.Health then
                                local hp = shell:GetAttribute("Health") or 100
                                local maxHp = math.max(shell:GetAttribute("MaxHealth") or 100, 1)
                                local hpPercent = math.clamp(hp / maxHp, 0, 1)
                                local sizeY = bounds.Height
                                local barHeight = sizeY * hpPercent
                                local offset = 4
                                drawings.Health.Visible = true
                                drawings.Health.From = Vector2.new(bounds.Left - offset, bounds.Bottom)
                                drawings.Health.To = Vector2.new(bounds.Left - offset, bounds.Bottom - barHeight)
                                drawings.Health.Color = hpPercent >= 0.7 and Color3.fromRGB(0, 255, 0) or (hpPercent >= 0.4 and Color3.fromRGB(255, 255, 0) or Color3.fromRGB(255, 0, 0))
                                drawings.Health.Thickness = 2
                            else drawings.Health.Visible = false end

                            if shouldDrawSkeleton then
                                for i, bone in ipairs(Bones) do local p1, p2 = char:FindFirstChild(bone[1]), char:FindFirstChild(bone[2]) if p1 and p2 then local pos1, on1 = Camera:WorldToViewportPoint(p1.Position) local pos2, on2 = Camera:WorldToViewportPoint(p2.Position) if on1 and on2 then drawings.SkelLines[i].Visible = true drawings.SkelLines[i].From = Vector2.new(pos1.X, pos1.Y) drawings.SkelLines[i].To = Vector2.new(pos2.X, pos2.Y) drawings.SkelLines[i].Color = cSkel else drawings.SkelLines[i].Visible = false end else drawings.SkelLines[i].Visible = false end end
                                local head = char:FindFirstChild("Head")
                                if head then local hPos, hOn = Camera:WorldToViewportPoint(head.Position) if hOn then drawings.SkelCircle.Visible = true drawings.SkelCircle.Position = Vector2.new(hPos.X, hPos.Y) local fovFactor = math.tan(math.rad(Camera.FieldOfView) / 2) local virtualHeadSize = 0.8 local calculatedRadius = (Camera.ViewportSize.Y / (2 * hPos.Z * fovFactor)) * virtualHeadSize drawings.SkelCircle.Radius = math.clamp(calculatedRadius, 1, 200) drawings.SkelCircle.Color = cSkel else drawings.SkelCircle.Visible = false end else drawings.SkelCircle.Visible = false end
                            else for _, l in pairs(drawings.SkelLines) do l.Visible = false end drawings.SkelCircle.Visible = false end
                        else
                            hideDrawings(drawings, char)
                        end
                    end -- fecha bloco de escopo
                else
                    hideDrawings(drawings, shell or (player.Character and player.Character) or nil)
                end
            end
        end))

        -- Aimbot
        local function getCharForPlayer(p)
            if p == LocalPlayer then return nil end
            return getVisibleShell(p)
        end

        local function IsValidAimbotTarget(p, char)
            if not char then return false end
            if p == LocalPlayer then return false end
            if ESP_Settings.TeamCheck then
                local myTeam = LocalPlayer:GetAttribute("Team")
                local eTeam  = p:GetAttribute("Team")
                if myTeam and eTeam and myTeam == eTeam then return false end
            end
            if not char:IsDescendantOf(workspace) then return false end
            if char:GetAttribute("Dead") == true then return false end
            local hp = char:GetAttribute("Health")
            if type(hp) == "number" and hp <= 0 then return false end
            if not char:FindFirstChild("HumanoidRootPart") then return false end
            return true
        end

        local charVelCache = {}
        NIGHT_TrackConnection(RunService.Heartbeat:Connect(function()
            if not NIGHT_IsCurrent() then return end
            Camera = workspace.CurrentCamera or Camera
            for _, p in ipairs(Players:GetPlayers()) do
                if p == LocalPlayer then continue end
                local c = getCharForPlayer(p)
                local r = c and c:FindFirstChild("HumanoidRootPart")
                if r then charVelCache[p] = r.AssemblyLinearVelocity end
            end
        end))

        local NightCurrentTarget = nil
        local function GetBestAimbotTarget()
            local center = Camera.ViewportSize / 2
            local fovRadius = (tonumber(Aimbot_Settings.FovSize) or 150) / 2
            local best, bestDist = nil, math.huge

            -- helper interno para avaliar um shell genérico (player ou bot)
            local function evalShell(char, teamAttr)
                if not char or not isShellAlive(char) then return end
                if ESP_Settings.TeamCheck then
                    local myTeam = LocalPlayer:GetAttribute("Team")
                    if myTeam and teamAttr and myTeam == teamAttr then return end
                end
                local part = GetDynamicTargetPart(char)
                if not part then return end
                if not IsPartVisible(part) then return end
                local worldDist = (part.Position - Camera.CFrame.Position).Magnitude
                if worldDist > Aimbot_Settings.MaxDistance then return end
                local s, onScreen = Camera:WorldToViewportPoint(part.Position)
                if not onScreen or s.Z <= 0 then return end
                local d = (Vector2.new(s.X, s.Y) - center).Magnitude
                if d > fovRadius then return end
                if d < bestDist then
                    bestDist = d
                    best = { player = nil, part = part, char = char, dist = d, isBot = true }
                end
            end

            -- players reais
            for _, p in ipairs(Players:GetPlayers()) do
                local char = getCharForPlayer(p)
                if not IsValidAimbotTarget(p, char) then continue end
                local part = GetDynamicTargetPart(char)
                if not part then continue end
                if not IsPartVisible(part) then continue end
                local worldDist = (part.Position - Camera.CFrame.Position).Magnitude
                if worldDist > Aimbot_Settings.MaxDistance then continue end
                local s, onScreen = Camera:WorldToViewportPoint(part.Position)
                if not onScreen or s.Z <= 0 then continue end
                local d = (Vector2.new(s.X, s.Y) - center).Magnitude
                if d > fovRadius then continue end
                if d < bestDist then bestDist = d best = { player = p, part = part, char = char, dist = d } end
            end

            -- bots (shells com Bot==true, sem player object)
            for _, botShell in ipairs(getAllBotShells()) do
                evalShell(botShell, botShell:GetAttribute("Team"))
            end

            if not best then NightCurrentTarget = nil return nil end
            if NightCurrentTarget == nil then NightCurrentTarget = best return NightCurrentTarget end
            -- se o alvo atual era um bot, valida direto pelo shell
            if NightCurrentTarget.isBot then
                if not isShellAlive(NightCurrentTarget.char) then NightCurrentTarget = best return NightCurrentTarget end
                return NightCurrentTarget
            end
            local cc = getCharForPlayer(NightCurrentTarget.player)
            if not IsValidAimbotTarget(NightCurrentTarget.player, cc) then NightCurrentTarget = best return NightCurrentTarget end
            local cPart = GetDynamicTargetPart(cc)
            if not cPart then NightCurrentTarget = best return NightCurrentTarget end
            local cs, csOnScreen = Camera:WorldToViewportPoint(cPart.Position)
            local cDist = csOnScreen and (Vector2.new(cs.X, cs.Y) - center).Magnitude or math.huge
            if not csOnScreen or cs.Z <= 0 or cDist > fovRadius then NightCurrentTarget = best return NightCurrentTarget end
            local switchThresh = Aimbot_Settings.SwitchThresh or 120
            if best.player ~= NightCurrentTarget.player and best.dist < switchThresh then NightCurrentTarget = best return NightCurrentTarget end
            NightCurrentTarget.part = cPart NightCurrentTarget.char = cc
            return NightCurrentTarget
        end

        local injectDelta = Vector2.new(0, 0)
        RunService:BindToRenderStep("NIGHT_Aimbot_Priority", Enum.RenderPriority.Camera.Value - 1, function()
            injectDelta = Vector2.new(0, 0)
            if not FunctionsEnabled or Aimbot_Settings.Mode == "Nenhum" or not IsAlive(LocalPlayer) then NightCurrentTarget = nil return end
            local canAim = (Aimbot_Settings.Type == "Ao Olhar")
                or (Aimbot_Settings.Type == "Ao Atirar" and IsLocalFireButtonHeld())
            if not canAim then NightCurrentTarget = nil return end
            local target = GetBestAimbotTarget()
            if not target then return end
            local targetPos = target.part.Position
            local dist = (targetPos - Camera.CFrame.Position).Magnitude
            if dist < 0.5 or dist > Aimbot_Settings.MaxDistance then NightCurrentTarget = nil return end
            local vel = charVelCache[target.player]
            if vel and vel.Magnitude > 0.5 then targetPos = targetPos + vel * (dist / 500) * 0.07 end
            local smoothBase = Aimbot_Settings.Mode == "Rage" and 0.85 or Aimbot_Settings.LegitSmooth
            local distFactor = math.clamp(1 - (dist / 1000), 0.3, 1)
            local smoothFinal = smoothBase * distFactor
            local camCF = Camera.CFrame
            local relCF = camCF:Inverse() * CFrame.new(camCF.Position, targetPos)
            local rx, ry, _ = relCF:ToEulerAnglesYXZ()
            local sens = math.max(UserInputService.MouseDeltaSensitivity, 0.001)
            injectDelta = Vector2.new(-ry / sens * smoothFinal, -rx / sens * smoothFinal)
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(camCF.Position, targetPos), smoothFinal)
        end)

        task.spawn(function()
            task.wait(2)
            local function hookCameraInput()
                local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                local ci = ps and ps:FindFirstChild("PlayerModule") and ps.PlayerModule:FindFirstChild("CameraModule") and ps.PlayerModule.CameraModule:FindFirstChild("CameraInput")
                if not ci then return false end
                local ok2, mod = pcall(require, ci)
                if not ok2 or not mod or not mod.getRotation then return false end
                if mod.__nightHooked then return true end
                local orig = mod.getRotation
                mod.getRotation = function(...)
                    local delta = orig(...)
                    if FunctionsEnabled and Aimbot_Settings.Mode ~= "Nenhum" and injectDelta.Magnitude > 0 then return delta + injectDelta end
                    return delta
                end
                mod.__nightHooked = true
                return true
            end
            -- Procura somente PlayerScripts/PlayerModule/CameraModule/CameraInput uma vez.
            hookCameraInput()
        end)
    end)

    -- Hitbox
    task.spawn(function()
        local HitboxCache = {} 
        local function IsEnemy(p) 
            if p == LocalPlayer then return false end 
            if not ESP_Settings.TeamCheck then return true end 
            if p.Team ~= nil and LocalPlayer.Team ~= nil then return p.Team ~= LocalPlayer.Team end 
            local m = LocalPlayer:GetAttribute("Team") local e = p:GetAttribute("Team") 
            if m ~= nil and e ~= nil then return m ~= e end 
            return true 
        end
        NIGHT_TrackConnection(RunService.Heartbeat:Connect(function()
            if not NIGHT_IsCurrent() then return end
            if FunctionsEnabled and HitboxEnabled then
                for _, p in pairs(Players:GetPlayers()) do 
                    if p ~= LocalPlayer and IsEnemy(p) and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                        local head = p.Character:FindFirstChild("Head")
                        if head then if not HitboxCache[p] then HitboxCache[p] = head.Size end head.Size = Vector3.new(2.1, 2.1, 2.1) head.Transparency = 0.7 head.CanCollide = true end
                    else if HitboxCache[p] and p.Character and p.Character:FindFirstChild("Head") then p.Character.Head.Size = HitboxCache[p] p.Character.Head.Transparency = 0 HitboxCache[p] = nil end end 
                end
            else 
                for p, os in pairs(HitboxCache) do if p and p.Character and p.Character:FindFirstChild("Head") then p.Character.Head.Size = os p.Character.Head.Transparency = 0 end end 
                table.clear(HitboxCache) 
            end
        end))
    end)
end

