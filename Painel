            if player == LocalPlayer then return false end
            if workspace:GetAttribute("Gamemode") == "Deathmatch" then return true end
            if not ESP_Settings.TeamCheck then return true end
            local myTeam = LocalPlayer:GetAttribute("Team")
            local eTeam  = player:GetAttribute("Team")
            if myTeam and eTeam then return myTeam ~= eTeam end
            if myTeam and not eTeam then return true end
            if not myTeam and eTeam then return true end
            return true
        end

