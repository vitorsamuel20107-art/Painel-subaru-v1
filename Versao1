#!/bin/bash
# PAINEL SUBARU VIP - ELITE APOSTADO (SISTEMA INTELIGENTE V3)

# Proteção do Terminal: Garante que o teclado volte se o script for abortado
trap "stty echo; clear; exit" INT TERM EXIT

# Cores
RED='\e[1;31m'
GOLD='\e[1;33m'
WHITE='\e[1;37m'
GREEN='\e[1;32m'
CYAN='\e[1;36m'
RESET='\e[0m'

# ==========================================================
# --- SISTEMA DE LOGIN PROTEGIDO ---
KEY_DISFARCADA="U1VCQVJVLTg4MjE="
KEY_REAL=$(echo "$KEY_DISFARCADA" | base64 -d)

clear
echo -e "${RED}============================================================${RESET}"
echo -e "${GOLD}          🔐 ACESSO RESTRITO - SUBARU VIP 🔐${RESET}"
echo -e "${RED}============================================================${RESET}"
echo -n -e "${WHITE} ➥ DIGITE SUA KEY DE ACESSO: ${RESET}"
read user_key

if [[ "$user_key" != "$KEY_REAL" ]]; then
    echo -e "\n${RED}[❌] KEY INCORRETA! ACESSO NEGADO.${RESET}"
    exit 1
fi
# ==========================================================

# Auto-Detecção do Dispositivo
MARCA=$(getprop ro.product.brand | tr '[:lower:]' '[:upper:]')
MODELO=$(getprop ro.product.model)
ANDROID_VER=$(getprop ro.build.version.release)
DISPOSITIVO="$MARCA $MODELO"

# Função de Injeção
injetar() {
    export RISH_APPLICATION_ID="com.termux"
    chmod -w ./rish_shizuku.dex > /dev/null 2>&1
    ./rish -c "$1" > /dev/null 2>&1
    return $?
}

# Função da Barra de Progresso Animada
barra_progresso() {
    local tarefa="$1"
    for i in {1..100}; do
        echo -ne "\r${WHITE} [!] $tarefa: ${CYAN}[${i}%]${RESET}"
        # Sleep super rápido para dar efeito visual sem demorar muito (aprox 1s no total)
        sleep 0.01
    done
    echo -e " ${GREEN}✅ OK${RESET}"
}

# Loop principal
while true; do
    clear
    echo -e "${RED}  ███████╗██╗   ██╗██████╗  █████╗ ██████╗ ██╗   ██╗"
    echo -e "  ██╔════╝██║   ██║██╔══██╗██╔══██╗██╔══██╗██║   ██║"
    echo -e "  ███████╗██║   ██║██████╔╝███████║██████╔╝██║   ██║"
    echo -e "  ╚════██║██║   ██║██╔══██╗██╔══██║██╔══██║██║   ██║"
    echo -e "  ███████║╚██████╔╝██████╔╝██║  ██║██║  ██║╚██████╔╝${RESET}"
    echo -e "${GOLD}          👑 PAINEL SUBARU VIP - ELITE APOSTADO 👑${RESET}"
    echo -e "${RED}============================================================${RESET}"
    echo -e "${RED} [!] AVISO: FASE DE TESTE, PODE NÃO FUNCIONAR EM ALGUNS CELULARES${RESET}"
    echo -e "${RED}============================================================${RESET}"
    echo -e " 📱 DISPOSITIVO: ${CYAN}$DISPOSITIVO${RESET}"
    echo -e " 🤖 SISTEMA:     ${CYAN}Android $ANDROID_VER (Shizuku Ativo)${RESET}"
    echo -e "${RED}============================================================${RESET}"
    echo -e "${WHITE} [01] 🎯 SENSI (TOUCH SLOP)   [07] 🔋 MODO PERFORMANCE${RESET}"
    echo -e "${WHITE} [02] 📱 DPI COMPETITIVA      [08] 🛡️ REDE & PING${RESET}"
    echo -e "${WHITE} [03] 🎯 DPI PADRÃO (CAPA)    [09] 📊 MONITOR DE TELA (Hz)${RESET}"
    echo -e "${WHITE} [04] 🧠 LIMPAR CACHE TOTAL   [10] 🧹 FECHAR SEGUNDO PLANO${RESET}"
    echo -e "${WHITE} [05] 🎮 GPU RENDER MAX       [11] 🖱️ VELOCIDADE PONTEIRO${RESET}"
    echo -e "${WHITE} [06] ⚡ FORÇAR 144Hz TELA    [12] 🔄 RESET TOTAL${RESET}"
    echo -e "${GOLD} [99] 🚀 INJEÇÃO TOTAL        [77] 🧠 OTIMIZAR SISTEMA${RESET}"
    echo -e "${RED} [00] ❌ SAIR DO PAINEL${RESET}"
    echo -e "${RED}------------------------------------------------------------${RESET}"
    echo -n -e "${GOLD} ➥ DIGITE O COMANDO VIP: ${RESET}"
    
    read opcao
    stty -echo

    case $opcao in
    99)
        echo -e "\n${GOLD}[🚀] INICIANDO INJEÇÃO TOTAL...${RESET}\n"
        
        barra_progresso "CALIBRANDO SENSI"
        injetar "settings put secure accessibility_touch_slop 1"
        
        barra_progresso "INJETANDO DPI 300"
        injetar "wm density 300"
        
        barra_progresso "ACELERANDO PONTEIRO"
        injetar "settings put system pointer_speed 14"
        
        barra_progresso "OTIMIZANDO GPU RENDER"
        injetar "setprop debug.hwui.renderer opengl"
        
        barra_progresso "FORÇANDO TELA 144Hz"
        injetar "settings put system min_refresh_rate 144.0"

        echo -e "\n${GREEN}[🔥] INJEÇÃO TOTAL CONCLUÍDA COM SUCESSO!${RESET}"
        sleep 3 ;;

    77)
        echo -e ""
        barra_progresso "COMPILANDO APPS (0 DELAY)"
        injetar "cmd package bg-dexopt-job"
        sleep 2 ;;

    01|1)
        echo -e ""
        barra_progresso "APLICANDO SENSI MÁXIMA"
        injetar "settings put secure accessibility_touch_slop 1"
        sleep 2 ;;

    02|2)
        echo -e ""
        barra_progresso "APLICANDO DPI 300"
        injetar "wm density 300"
        sleep 2 ;;

    03|3)
        echo -e ""
        barra_progresso "RESETANDO DPI"
        injetar "wm density reset"
        sleep 2 ;;

    04|4)
        echo -e ""
        barra_progresso "LIMPANDO CACHE DO SISTEMA"
        injetar "pm trim-caches 999G"
        sleep 2 ;;

    05|5)
        echo -e ""
        barra_progresso "ATIVANDO GPU OPENGL"
        injetar "setprop debug.hwui.renderer opengl"
        sleep 2 ;;

    06|6)
        echo -e ""
        barra_progresso "TRAVANDO TELA EM 144Hz"
        injetar "settings put system min_refresh_rate 144.0"
        sleep 2 ;;

    07|7)
        echo -e ""
        barra_progresso "DESATIVANDO LIMITES (BATERIA)"
        injetar "dumpsys deviceidle disable"
        sleep 2 ;;

    08|8)
        echo -e ""
        barra_progresso "OTIMIZANDO REDE (PING)"
        injetar "settings put global wifi_scan_always_enabled 0"
        sleep 2 ;;

    09|9)
        echo -e ""
        barra_progresso "INICIANDO MONITOR DE TELA"
        injetar "settings put secure show_refresh_rate 1"
        sleep 2 ;;

    10)
        echo -e ""
        barra_progresso "ENCERRANDO APPS EM 2º PLANO"
        injetar "am kill-all"
        sleep 2 ;;

    11)
        echo -e ""
        barra_progresso "MAXIMIZANDO PONTEIRO"
        injetar "settings put system pointer_speed 14"
        sleep 2 ;;

    12)
        echo -e ""
        barra_progresso "RESETANDO TODAS CONFIGURAÇÕES"
        injetar "wm density reset"
        injetar "settings put secure show_refresh_rate 0"
        injetar "dumpsys deviceidle enable"
        injetar "settings put secure accessibility_touch_slop 3"
        sleep 2 ;;

    00|0) 
        stty echo
        clear
        exit 0 ;;
    *) 
        ;;
    esac

    read -t 0.1 -n 10000 discard
    stty echo
done
